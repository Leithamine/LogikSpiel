<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LogikSpiel"
              xmlns:view="clr-namespace:LogikSpiel.View"
             x:Class="LogikSpiel.App">
    <Application.Resources>
        <ResourceDictionary>
            <view:StringNotNullOrEmptyConverter x:Key="StringNotNullOrEmptyConverter" />
            <view:LockedToButtonTextConverter x:Key="LockedToButtonTextConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
