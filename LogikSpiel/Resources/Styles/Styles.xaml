<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════
         🎨 NEUE FARBPALETTE - Lebendig & Modern
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Primary Colors - Vibrant Cyan/Teal -->
    <Color x:Key="C_Primary">#00D9FF</Color>
    <Color x:Key="C_PrimaryDark">#00A8CC</Color>
    <Color x:Key="C_PrimaryLight">#7FFFFF</Color>

    <!-- Secondary Colors - Electric Purple -->
    <Color x:Key="C_Secondary">#B537F2</Color>
    <Color x:Key="C_SecondaryDark">#8B2FC9</Color>
    <Color x:Key="C_SecondaryLight">#E066FF</Color>

    <!-- Accent Colors - Hot Pink/Coral -->
    <Color x:Key="C_Accent">#FF6B9D</Color>
    <Color x:Key="C_AccentDark">#E84A7F</Color>
    <Color x:Key="C_AccentLight">#FFB3C6</Color>

    <!-- Success/Warning/Error -->
    <Color x:Key="C_Success">#00E676</Color>
    <Color x:Key="C_Warning">#FFAB40</Color>
    <Color x:Key="C_Error">#FF5252</Color>

    <!-- Gold für Coins -->
    <Color x:Key="C_Gold">#FFD700</Color>
    <Color x:Key="C_GoldDark">#FFA500</Color>

    <!-- Background Colors - Deep Dark with Purple tint -->
    <Color x:Key="C_BgDark">#0A0A1A</Color>
    <Color x:Key="C_BgMedium">#12122A</Color>
    <Color x:Key="C_BgLight">#1A1A3A</Color>
    <Color x:Key="C_BgCard">#20203A</Color>

    <!-- Text Colors -->
    <Color x:Key="C_TextPrimary">#FFFFFF</Color>
    <Color x:Key="C_TextSecondary">#B8B8D0</Color>
    <Color x:Key="C_TextMuted">#6B6B8A</Color>

    <!-- Glass Colors -->
    <Color x:Key="C_GlassWhite">#18FFFFFF</Color>
    <Color x:Key="C_GlassBorder">#30FFFFFF</Color>
    <Color x:Key="C_GlassHighlight">#40FFFFFF</Color>

    <!-- ═══════════════════════════════════════════════════════════════════
         🌈 GRADIENTS
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Main Background - Aurora Style -->
    <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0F0C29" Offset="0.0"/>
        <GradientStop Color="#302B63" Offset="0.5"/>
        <GradientStop Color="#24243E" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Alternative - Sunset Vibes -->
    <LinearGradientBrush x:Key="BgGradientWarm" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A0A2E" Offset="0.0"/>
        <GradientStop Color="#3D1A54" Offset="0.5"/>
        <GradientStop Color="#2D1B4E" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Card Gradients -->
    <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#25254A" Offset="0.0"/>
        <GradientStop Color="#1A1A3A" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Button Gradients -->
    <LinearGradientBrush x:Key="BtnPrimaryGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00D9FF" Offset="0.0"/>
        <GradientStop Color="#00A8CC" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BtnSecondaryGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#B537F2" Offset="0.0"/>
        <GradientStop Color="#8B2FC9" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BtnAccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF6B9D" Offset="0.0"/>
        <GradientStop Color="#FF8E53" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BtnSuccessGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00E676" Offset="0.0"/>
        <GradientStop Color="#00C853" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFD700" Offset="0.0"/>
        <GradientStop Color="#FFA500" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- ═══════════════════════════════════════════════════════════════════
         ✨ SHADOWS
         ═══════════════════════════════════════════════════════════════════ -->

    <Shadow x:Key="ShadowSmall" Brush="#40000000" Offset="0,2" Radius="4"/>
    <Shadow x:Key="ShadowMedium" Brush="#50000000" Offset="0,4" Radius="8"/>
    <Shadow x:Key="ShadowLarge" Brush="#60000000" Offset="0,8" Radius="16"/>
    <Shadow x:Key="ShadowGlow" Brush="#4000D9FF" Offset="0,0" Radius="20"/>
    <Shadow x:Key="ShadowGlowPink" Brush="#40FF6B9D" Offset="0,0" Radius="20"/>

    <!-- ═══════════════════════════════════════════════════════════════════
         📝 TYPOGRAPHY
         ═══════════════════════════════════════════════════════════════════ -->

    <Style x:Key="H1" TargetType="Label">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource C_TextPrimary}"/>
    </Style>

    <Style x:Key="H2" TargetType="Label">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource C_TextPrimary}"/>
    </Style>

    <Style x:Key="H3" TargetType="Label">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource C_TextPrimary}"/>
    </Style>

    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="TextColor" Value="{StaticResource C_TextSecondary}"/>
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{StaticResource C_TextMuted}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         🎴 CARD STYLES
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Glass Card - Modern Glassmorphism -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource C_GlassWhite}"/>
        <Setter Property="Stroke" Value="{StaticResource C_GlassBorder}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 20"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Shadow" Value="{StaticResource ShadowMedium}"/>
    </Style>

    <!-- Solid Card -->
    <Style x:Key="SolidCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource C_BgCard}"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 20"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Shadow" Value="{StaticResource ShadowMedium}"/>
    </Style>

    <!-- Glow Card - with neon border -->
    <Style x:Key="GlowCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource C_BgCard}"/>
        <Setter Property="Stroke" Value="{StaticResource C_Primary}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 20"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Shadow" Value="{StaticResource ShadowGlow}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         🔘 BUTTON STYLES
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Primary Button - Cyan -->
    <Style x:Key="BtnPrimary" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource C_Primary}"/>
        <Setter Property="TextColor" Value="#000000"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="HeightRequest" Value="52"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="Shadow" Value="{StaticResource ShadowGlow}"/>
    </Style>

    <!-- Secondary Button - Purple -->
    <Style x:Key="BtnSecondary" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource C_Secondary}"/>
        <Setter Property="TextColor" Value="#FFFFFF"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="HeightRequest" Value="52"/>
        <Setter Property="Padding" Value="24,0"/>
    </Style>

    <!-- Accent Button - Pink/Coral -->
    <Style x:Key="BtnAccent" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource C_Accent}"/>
        <Setter Property="TextColor" Value="#FFFFFF"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="HeightRequest" Value="52"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="Shadow" Value="{StaticResource ShadowGlowPink}"/>
    </Style>

    <!-- Success Button - Green -->
    <Style x:Key="BtnSuccess" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource C_Success}"/>
        <Setter Property="TextColor" Value="#000000"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="HeightRequest" Value="52"/>
        <Setter Property="Padding" Value="24,0"/>
    </Style>

    <!-- Ghost Button - Transparent with border -->
    <Style x:Key="BtnGhost" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{StaticResource C_TextPrimary}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="HeightRequest" Value="48"/>
        <Setter Property="BorderColor" Value="{StaticResource C_GlassBorder}"/>
        <Setter Property="BorderWidth" Value="1"/>
    </Style>

    <!-- Icon Button - Circle -->
    <Style x:Key="BtnIcon" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource C_GlassWhite}"/>
        <Setter Property="TextColor" Value="{StaticResource C_TextPrimary}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="WidthRequest" Value="48"/>
        <Setter Property="HeightRequest" Value="48"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderColor" Value="{StaticResource C_GlassBorder}"/>
        <Setter Property="BorderWidth" Value="1"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         🏷️ CHIPS & BADGES
         ═══════════════════════════════════════════════════════════════════ -->

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource C_GlassWhite}"/>
        <Setter Property="Stroke" Value="{StaticResource C_GlassBorder}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 14"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="HeightRequest" Value="36"/>
    </Style>

    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource C_Accent}"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinimumWidthRequest" Value="24"/>
        <Setter Property="MinimumHeightRequest" Value="24"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         📱 INPUT STYLES
         ═══════════════════════════════════════════════════════════════════ -->

    <Style x:Key="EntryModern" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{StaticResource C_BgLight}"/>
        <Setter Property="TextColor" Value="{StaticResource C_TextPrimary}"/>
        <Setter Property="PlaceholderColor" Value="{StaticResource C_TextMuted}"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

</ResourceDictionary>
