<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Shadows: auf hellen BGs eher “soft” -->
    <Shadow x:Key="ShadowSmall" Brush="#22000000" Offset="0,2" Radius="6"/>
    <Shadow x:Key="ShadowMedium" Brush="#2A000000" Offset="0,6" Radius="14"/>
    <Shadow x:Key="ShadowCard" Brush="#26000000" Offset="0,10" Radius="18"/>
    <Shadow x:Key="ShadowGlowBlue" Brush="#332F80ED" Offset="0,0" Radius="22"/>

    <!-- BUTTONS (erst definieren, dann Alias benutzen!) -->
    <Style x:Key="BtnIcon" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource C_GlassStrong}"/>
        <Setter Property="TextColor" Value="{StaticResource C_TextPrimary}"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="WidthRequest" Value="44"/>
        <Setter Property="HeightRequest" Value="44"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderColor" Value="{StaticResource C_BorderSoft}"/>
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="Shadow" Value="{StaticResource ShadowSmall}"/>
    </Style>

    <!-- Alias: PascalTrianglePage nutzt IconButton -->
    <Style x:Key="IconButton"
           TargetType="Button"
           BasedOn="{StaticResource BtnIcon}" />

    <!-- Fehlender Button-Style: GameMapPage nutzt BtnSecondary -->
    <Style x:Key="BtnSecondary" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource C_PrimaryDark}"/>
        <Setter Property="TextColor" Value="{StaticResource C_TextOnDark}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="Shadow" Value="{StaticResource ShadowSmall}"/>
    </Style>

    <Style x:Key="BtnPrimary" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource C_Primary}"/>
        <Setter Property="TextColor" Value="{StaticResource C_TextOnDark}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="Shadow" Value="{StaticResource ShadowSmall}"/>
    </Style>

    <Style x:Key="BtnAccent" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource C_Accent}"/>
        <Setter Property="TextColor" Value="{StaticResource C_TextPrimary}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="Shadow" Value="{StaticResource ShadowSmall}"/>
    </Style>

    <Style x:Key="BtnSuccess" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource C_Success}"/>
        <Setter Property="TextColor" Value="{StaticResource C_TextOnDark}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="Shadow" Value="{StaticResource ShadowSmall}"/>
    </Style>

    <Style x:Key="BtnGhost" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource C_GlassWhite}"/>
        <Setter Property="TextColor" Value="{StaticResource C_TextPrimary}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="HeightRequest" Value="48"/>
        <Setter Property="BorderColor" Value="{StaticResource C_BorderSoft}"/>
        <Setter Property="BorderWidth" Value="1"/>
    </Style>

    <!-- Typo -->
    <Style x:Key="H1" TargetType="Label">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource C_TextPrimary}"/>
    </Style>

    <Style x:Key="H2" TargetType="Label">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource C_TextPrimary}"/>
    </Style>

    <Style x:Key="H3" TargetType="Label">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource C_TextPrimary}"/>
    </Style>

    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{StaticResource C_TextSecondary}"/>
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{StaticResource C_TextMuted}"/>
    </Style>

    <!-- CARDS -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource C_GlassWhite}"/>
        <Setter Property="Stroke" Value="{StaticResource C_BorderSoft}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 18"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Shadow" Value="{StaticResource ShadowCard}"/>
    </Style>

    <Style x:Key="SolidCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource C_Card}"/>
        <Setter Property="Stroke" Value="{StaticResource C_BorderSoft}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 18"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Shadow" Value="{StaticResource ShadowCard}"/>
    </Style>

    <Style x:Key="GlowCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource C_Card}"/>
        <Setter Property="Stroke" Value="#662F80ED"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 18"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Shadow" Value="{StaticResource ShadowMedium}"/>
    </Style>

    <!-- CHIPS / BADGES -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource C_GlassStrong}"/>
        <Setter Property="Stroke" Value="{StaticResource C_BorderSoft}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Shadow" Value="{StaticResource ShadowSmall}"/>
    </Style>

    <Style x:Key="CoinBadge" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#E6FFFFFF"/>
        <Setter Property="Stroke" Value="#33F2C94C"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 14"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Shadow" Value="{StaticResource ShadowSmall}"/>
    </Style>

    <!-- INPUT -->
    <Style x:Key="DigitBox" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource C_SurfaceStrong}"/>
        <Setter Property="Stroke" Value="{StaticResource C_InputBorder}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 14"/>
        <Setter Property="HeightRequest" Value="62"/>
        <Setter Property="WidthRequest" Value="54"/>
        <Setter Property="Shadow" Value="{StaticResource ShadowSmall}"/>
    </Style>

</ResourceDictionary>
