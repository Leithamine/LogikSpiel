<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Dark UI: dunkler Hintergrund → helle Texte -->
    <Color x:Key="C_TextPrimary">#FFFFFF</Color>
    <Color x:Key="C_TextSecondary">#DADADA</Color>
    <Color x:Key="C_TextMuted">#B0B6C2</Color>
    <Color x:Key="C_TextOnDark">#FFFFFF</Color>

    <!-- Core Brand (passt zu Sky/Pastel) -->
    <Color x:Key="C_Primary">#2F80ED</Color>
    <!-- klarer Himmelblau -->
    <Color x:Key="C_PrimarySoft">#BFD9FF</Color>
    <!-- soft outline -->
    <Color x:Key="C_PrimaryDark">#1F5FB5</Color>

    <Color x:Key="C_Accent">#F2C94C</Color>
    <!-- warmes Gold -->
    <Color x:Key="C_AccentDark">#C99A16</Color>
    <Color x:Key="C_Warning">#F2994A</Color>

    <Color x:Key="C_Success">#2D9CDB</Color>
    <!-- NICHT grün → success in blau -->
    <Color x:Key="C_Error">#EB5757</Color>

    <!-- Glass / Surfaces -->
    <Color x:Key="C_Surface">#1C2330</Color>
    <Color x:Key="C_SurfaceStrong">#232B38</Color>

    <!-- Dunkles Glass auf dunklen BGs -->
    <Color x:Key="C_GlassWhite">#CC1E2532</Color>
    <!-- 80% -->
    <Color x:Key="C_GlassStrong">#E61E2532</Color>
    <!-- 90% -->
    <Color x:Key="C_GlassHighlight">#B31E2532</Color>
    <!-- 70% -->
    <!-- Aliase / fehlende Keys, die in XAML verwendet werden -->
    <Color x:Key="C_GoldDark">#C99A16</Color>
    <!-- entspricht deinem C_AccentDark -->
    <Color x:Key="C_TextOnColor">#FFFFFF</Color>
    <!-- Text auf Primary/Accent -->
    <Color x:Key="C_TextDark">#101216</Color>
    <!-- Alias zu C_TextPrimary -->

    <Color x:Key="C_BgLight">#1B2230</Color>
    <!-- passt zu InputBg -->
    <Color x:Key="C_BgDark">#121722</Color>
    <!-- dunkle Fläche (z.B. Hangman) -->

    <Color x:Key="C_GlassSoft">#991E2532</Color>
    <!-- 60% -->
    <Color x:Key="C_Divider">#22FFFFFF</Color>
    <!-- dezente Trennlinie -->

    <Color x:Key="C_Accent2">#F2994A</Color>
    <!-- nimm Warning als Accent2 -->

    <!-- Borders (auf dunklen BGs brauchen wir helle, sehr subtile Kanten) -->
    <Color x:Key="C_BorderSoft">#33FFFFFF</Color>
    <!-- sehr soft -->
    <Color x:Key="C_Border">#4DFFFFFF</Color>

    <!-- Cards -->
    <Color x:Key="C_Card">#CC222B39</Color>
    <Color x:Key="C_CardInner">#FF2A3342</Color>

    <!-- Inputs -->
    <Color x:Key="C_InputBg">#1F2733</Color>
    <Color x:Key="C_InputBorder">#332F80ED</Color>

    <!-- Coins -->
    <Color x:Key="C_Gold">#F2C94C</Color>

    <!-- Path Colors (pastellig, nicht neon) -->
    <Color x:Key="C_PathInactive">#66FFFFFF</Color>
    <!-- soft white -->
    <Color x:Key="C_PathActiveA">#7BB9FF</Color>
    <!-- soft blue -->
    <Color x:Key="C_PathActiveB">#F2B6D8</Color>
    <!-- soft pink -->

    <!-- Nodes -->
    <Color x:Key="C_NodeLockedFill">#2A313E</Color>
    <Color x:Key="C_NodeLockedStroke">#3C4656</Color>

    <Color x:Key="C_NodeDoneFill">#2F80ED</Color>
    <Color x:Key="C_NodeDoneStroke">#2F80ED</Color>

    <Color x:Key="C_NodeCurrentFill">#1E2532</Color>
    <Color x:Key="C_NodeCurrentStroke">#F2C94C</Color>

    <Color x:Key="C_BubbleNeutral">#FF2A3342</Color>
    <Color x:Key="C_BubbleSuccess">#4CAF50</Color>
    <Color x:Key="C_BubbleError">#EB5757</Color>

    <!-- MathCross cells (space/dark theme) -->
    <Color x:Key="C_MathCell_Fixed_Bg">#313B4A</Color>
    <Color x:Key="C_MathCell_Fixed_Border">#646B76</Color>
    <Color x:Key="C_MathCell_Fixed_Text">#E8EDF5</Color>

    <Color x:Key="C_MathCell_Num_Bg">#23445E</Color>
    <Color x:Key="C_MathCell_Num_Border">#5EA6D8</Color>
    <Color x:Key="C_MathCell_Num_Text">#F3FAFF</Color>

    <Color x:Key="C_MathCell_Op_Bg">#3A3556</Color>
    <Color x:Key="C_MathCell_Op_Border">#9A8BE0</Color>
    <Color x:Key="C_MathCell_Op_Text">#F7F4FF</Color>

    <Color x:Key="C_MathCell_Num_HoverBg">#2B5370</Color>
    <Color x:Key="C_MathCell_Num_HoverBorder">#79BCEB</Color>
    <Color x:Key="C_MathCell_Num_Glow">#595EA6D8</Color>

    <Color x:Key="C_MathCell_Op_HoverBg">#474164</Color>
    <Color x:Key="C_MathCell_Op_HoverBorder">#B2A4F0</Color>
    <Color x:Key="C_MathCell_Op_Glow">#599A8BE0</Color>
</ResourceDictionary>
