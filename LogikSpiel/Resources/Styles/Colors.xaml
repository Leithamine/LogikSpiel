<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Hintergrund-Images sind sehr hell → wir nehmen helle Glass-Flächen + dunkle Texte -->
    <Color x:Key="C_TextPrimary">#101216</Color>
    <Color x:Key="C_TextSecondary">#3B3F48</Color>
    <Color x:Key="C_TextMuted">#707785</Color>
    <Color x:Key="C_TextOnDark">#FFFFFF</Color>

    <!-- Core Brand (passt zu Sky/Pastel) -->
    <Color x:Key="C_Primary">#2F80ED</Color>
    <!-- klarer Himmelblau -->
    <Color x:Key="C_PrimarySoft">#BFD9FF</Color>
    <!-- soft outline -->
    <Color x:Key="C_PrimaryDark">#1F5FB5</Color>

    <Color x:Key="C_Accent">#F2C94C</Color>
    <!-- warmes Gold -->
    <Color x:Key="C_AccentDark">#C99A16</Color>
    <Color x:Key="C_Warning">#F2994A</Color>

    <Color x:Key="C_Success">#2D9CDB</Color>
    <!-- NICHT grün → success in blau -->
    <Color x:Key="C_Error">#EB5757</Color>

    <!-- Glass / Surfaces -->
    <Color x:Key="C_Surface">#F8FAFF</Color>
    <Color x:Key="C_SurfaceStrong">#FFFFFF</Color>

    <!-- “Glass” auf hellen BGs: weiß, aber leicht transparent -->
    <Color x:Key="C_GlassWhite">#D9FFFFFF</Color>
    <!-- 85% -->
    <Color x:Key="C_GlassStrong">#F2FFFFFF</Color>
    <!-- 95% -->
    <Color x:Key="C_GlassHighlight">#B3FFFFFF</Color>
    <!-- 70% -->
    <!-- Aliase / fehlende Keys, die in XAML verwendet werden -->
    <Color x:Key="C_GoldDark">#C99A16</Color>
    <!-- entspricht deinem C_AccentDark -->
    <Color x:Key="C_TextOnColor">#FFFFFF</Color>
    <!-- Text auf Primary/Accent -->
    <Color x:Key="C_TextDark">#101216</Color>
    <!-- Alias zu C_TextPrimary -->

    <Color x:Key="C_BgLight">#F3F6FF</Color>
    <!-- passt zu InputBg -->
    <Color x:Key="C_BgDark">#1A1D24</Color>
    <!-- dunkle Fläche (z.B. Hangman) -->

    <Color x:Key="C_GlassSoft">#B3FFFFFF</Color>
    <!-- 70% White (du hast C_GlassHighlight so ähnlich) -->
    <Color x:Key="C_Divider">#22000000</Color>
    <!-- dezente Trennlinie -->

    <Color x:Key="C_Accent2">#F2994A</Color>
    <!-- nimm Warning als Accent2 -->

    <!-- Borders (auf hellen BGs brauchen wir dunkle, sehr subtile Kanten) -->
    <Color x:Key="C_BorderSoft">#22000000</Color>
    <!-- sehr soft -->
    <Color x:Key="C_Border">#33000000</Color>

    <!-- Cards -->
    <Color x:Key="C_Card">#E6FFFFFF</Color>
    <Color x:Key="C_CardInner">#FFFFFFFF</Color>

    <!-- Inputs -->
    <Color x:Key="C_InputBg">#F3F6FF</Color>
    <Color x:Key="C_InputBorder">#332F80ED</Color>

    <!-- Coins -->
    <Color x:Key="C_Gold">#F2C94C</Color>

    <!-- Path Colors (pastellig, nicht neon) -->
    <Color x:Key="C_PathInactive">#66FFFFFF</Color>
    <!-- soft white -->
    <Color x:Key="C_PathActiveA">#7BB9FF</Color>
    <!-- soft blue -->
    <Color x:Key="C_PathActiveB">#F2B6D8</Color>
    <!-- soft pink -->

    <!-- Nodes -->
    <Color x:Key="C_NodeLockedFill">#E6FFFFFF</Color>
    <Color x:Key="C_NodeLockedStroke">#33000000</Color>

    <Color x:Key="C_NodeDoneFill">#D6ECFF</Color>
    <Color x:Key="C_NodeDoneStroke">#2F80ED</Color>

    <Color x:Key="C_NodeCurrentFill">#FFFFFF</Color>
    <Color x:Key="C_NodeCurrentStroke">#2F80ED</Color>

</ResourceDictionary>
