<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LogikSpiel.ViewModel"
             xmlns:resx="clr-namespace:LogikSpiel.Resources.Strings"
             x:Class="LogikSpiel.View.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundImageSource="gamebg.png">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <Border Grid.Row="0"
                Style="{StaticResource GlassCard}"
                Padding="16,12"
                Margin="16,16,16,0">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <Button Grid.Column="0"
                        Text="←"
                        Style="{StaticResource BtnIcon}"
                        Command="{Binding BackCommand}"/>

                <Label Grid.Column="1"
                       Text="{resx:Translate Key=Profile_Title}"
                       Style="{StaticResource H2}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>

                <Border Grid.Column="2" Style="{StaticResource CoinBadge}">
                    <Label Text="{Binding Coins, StringFormat='💰 {0}'}"
                           TextColor="{StaticResource C_GoldDark}"
                           FontAttributes="Bold"/>
                </Border>

            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="16">

                <Border Style="{StaticResource GlassCard}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">

                        <Border StrokeThickness="3"
                                Stroke="{StaticResource C_Primary}"
                                WidthRequest="100" HeightRequest="100"
                                StrokeShape="RoundRectangle 50"
                                BackgroundColor="{StaticResource C_GlassSoft}">
                            <Image Source="professor.png" Aspect="AspectFill"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Label Text="{Binding Name}"
                                   FontSize="24" FontAttributes="Bold"
                                   TextColor="{StaticResource C_TextPrimary}"/>

                            <Border BackgroundColor="{StaticResource C_GlassSoft}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    Padding="8,4">
                                <Label Text="{Binding Age, StringFormat={x:Static resx:AppResources.Profile_AgeFormat}}"
                                       FontSize="12"
                                       TextColor="{StaticResource C_TextSecondary}"/>
                            </Border>

                            <Label Text="{Binding Id, StringFormat={x:Static resx:AppResources.Profile_IdFormat}}"
                                   FontSize="10"
                                   TextColor="{StaticResource C_TextMuted}"/>
                        </VerticalStackLayout>

                    </Grid>
                </Border>

                <Border Style="{StaticResource GlassCard}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{resx:Translate Key=Profile_StatsTitle}" Style="{StaticResource H3}"/>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">

                            <Border BackgroundColor="{StaticResource C_GlassSoft}"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0"
                                    Padding="12">
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="🎮" FontSize="24" HorizontalOptions="Center"/>
                                    <Label Text="42" FontSize="20" FontAttributes="Bold"
                                           TextColor="{StaticResource C_TextPrimary}" HorizontalOptions="Center"/>
                                    <Label Text="{resx:Translate Key=Profile_StatsPlayed}" FontSize="10"
                                           TextColor="{StaticResource C_TextMuted}" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border BackgroundColor="{StaticResource C_GlassSoft}"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0"
                                    Padding="12">
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="✅" FontSize="24" HorizontalOptions="Center"/>
                                    <Label Text="38" FontSize="20" FontAttributes="Bold"
                                           TextColor="{StaticResource C_Success}" HorizontalOptions="Center"/>
                                    <Label Text="{resx:Translate Key=Profile_StatsSolved}" FontSize="10"
                                           TextColor="{StaticResource C_TextMuted}" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border BackgroundColor="{StaticResource C_GlassSoft}"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0"
                                    Padding="12">
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="🔥" FontSize="24" HorizontalOptions="Center"/>
                                    <Label Text="3" FontSize="20" FontAttributes="Bold"
                                           TextColor="{StaticResource C_Accent2}" HorizontalOptions="Center"/>
                                    <Label Text="{resx:Translate Key=Profile_StatsStreak}" FontSize="10"
                                           TextColor="{StaticResource C_TextMuted}" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>

                        </Grid>

                        <Button Text="{resx:Translate Key=Profile_StatsAll}"
                                Style="{StaticResource BtnGhost}"
                                Command="{Binding ShowStatsCommand}"/>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource GlassCard}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="{resx:Translate Key=Profile_SettingsTitle}" Style="{StaticResource H3}"/>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border BackgroundColor="{StaticResource C_GlassSoft}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    WidthRequest="44" HeightRequest="44">
                                <Label Text="🎵" FontSize="20"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{resx:Translate Key=Profile_MusicTitle}" TextColor="{StaticResource C_TextPrimary}" FontAttributes="Bold"/>
                                <Label Text="{resx:Translate Key=Profile_MusicSubtitle}" FontSize="11" TextColor="{StaticResource C_TextMuted}"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="2"
                                    IsToggled="{Binding IsMusicEnabled}"
                                    OnColor="{StaticResource C_Primary}"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource C_Divider}"/>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border BackgroundColor="{StaticResource C_GlassSoft}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    WidthRequest="44" HeightRequest="44">
                                <Label Text="🔊" FontSize="20"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{resx:Translate Key=Profile_SoundTitle}" TextColor="{StaticResource C_TextPrimary}" FontAttributes="Bold"/>
                                <Label Text="{resx:Translate Key=Profile_SoundSubtitle}" FontSize="11" TextColor="{StaticResource C_TextMuted}"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="2"
                                    IsToggled="{Binding IsSoundEnabled}"
                                    OnColor="{StaticResource C_Primary}"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <Label Text="{resx:Translate Key=Profile_Version}"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource C_TextMuted}"
                       FontSize="11"
                       Margin="0,8"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
