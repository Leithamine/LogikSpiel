<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LogikSpiel.ViewModel"
             x:Class="LogikSpiel.View.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#BB86FC" Offset="0"/>
            <GradientStop Color="#03DAC5" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *" RowSpacing="0">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" HeightRequest="60" Padding="15,0" BackgroundColor="#20000000">
            <Button Grid.Column="0" Text="Zurück" Command="{Binding BackCommand}" 
                    BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold"/>

            <Label Grid.Column="1" Text="Mein Profil" 
                   TextColor="White" FontAttributes="Bold" FontSize="18" 
                   VerticalOptions="Center" HorizontalOptions="Center"/>

            <Label Grid.Column="2" Text="{Binding Coins, StringFormat='💰 {0}'}" 
                   TextColor="#FFD700" FontAttributes="Bold" FontSize="16" VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="25">

                <Border StrokeShape="RoundRectangle 20" BackgroundColor="#F0FFFFFF" Padding="30" StrokeThickness="0">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Image Source="professor.png" HeightRequest="120" WidthRequest="120" Aspect="AspectFit"/>

                        <Label Text="{Binding Name}" FontSize="28" FontAttributes="Bold" TextColor="#2B2B2B" HorizontalOptions="Center"/>
                        <Label Text="{Binding Age, StringFormat='Alter: {0}'}" FontSize="16" TextColor="#555" HorizontalOptions="Center"/>
                        <Label Text="{Binding Id, StringFormat='ID: {0}'}" FontSize="10" TextColor="#888" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Button Text="📊 Statistiken ansehen" 
                        Command="{Binding ShowStatsCommand}"
                        BackgroundColor="#FFFFFF"
                        TextColor="#BB86FC"
                        FontAttributes="Bold"
                        CornerRadius="15"
                        HeightRequest="60"/>

                <Label Text="Einstellungen" FontSize="18" FontAttributes="Bold" TextColor="White" Margin="0,10,0,0"/>

                <Border StrokeShape="RoundRectangle 15" BackgroundColor="#F0FFFFFF" Padding="15" StrokeThickness="0">
                    <VerticalStackLayout Spacing="15">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Musik" VerticalOptions="Center" TextColor="#333"/>
                            <Switch Grid.Column="1" IsToggled="{Binding IsMusicEnabled}" OnColor="#BB86FC"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#DDD"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Soundeffekte" VerticalOptions="Center" TextColor="#333"/>
                            <Switch Grid.Column="1" IsToggled="{Binding IsSoundEnabled}" OnColor="#BB86FC"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>