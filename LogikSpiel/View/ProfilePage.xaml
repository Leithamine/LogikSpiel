<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LogikSpiel.ViewModel"
             x:Class="LogikSpiel.View.ProfilePage"
             Title="Mein Profil"
             Shell.NavBarIsVisible="True"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Border StrokeShape="RoundRectangle 20" BackgroundColor="White" Padding="20">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Image Source="professor.png" HeightRequest="100"/>
                    <Label Text="{Binding Name}" FontSize="24" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center"/>
                    <Label Text="{Binding Coins, StringFormat='💰 {0} Coins'}" FontSize="18" TextColor="#FFD700" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="{Binding Id, StringFormat='ID: {0}'}" FontSize="10" TextColor="Gray" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Deine Daten" FontSize="18" FontAttributes="Bold" TextColor="Black"/>
            <Border StrokeShape="RoundRectangle 10" BackgroundColor="White" Padding="15">
                <VerticalStackLayout Spacing="15">
                    <Grid ColumnDefinitions="100, *" RowDefinitions="Auto, Auto" RowSpacing="15">
                        <Label Grid.Row="0" Grid.Column="0" Text="Name:" VerticalOptions="Center"/>
                        <Entry Grid.Row="0" Grid.Column="1" Text="{Binding Name}" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Alter:" VerticalOptions="Center"/>
                        <Entry Grid.Row="1" Grid.Column="1" Text="{Binding Age}" Keyboard="Numeric"/>
                    </Grid>
                    <Button Text="Daten Speichern" Command="{Binding SaveDataCommand}" BackgroundColor="#BB86FC"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Einstellungen" FontSize="18" FontAttributes="Bold" TextColor="Black"/>
            <Border StrokeShape="RoundRectangle 10" BackgroundColor="White" Padding="15">
                <VerticalStackLayout Spacing="15">
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="15">
                        <Label Grid.Row="0" Grid.Column="0" Text="Musik" VerticalOptions="Center"/>
                        <Switch Grid.Row="0" Grid.Column="1" IsToggled="{Binding IsMusicEnabled}" OnColor="#03DAC5"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="Soundeffekte" VerticalOptions="Center"/>
                        <Switch Grid.Row="1" Grid.Column="1" IsToggled="{Binding IsSoundEnabled}" OnColor="#03DAC5"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>