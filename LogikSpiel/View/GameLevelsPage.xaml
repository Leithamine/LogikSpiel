<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="LogikSpiel.View.GameLevelsPage"
             x:Name="RootPage"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#BB86FC" Offset="0"/>
            <GradientStop Color="#03DAC5" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="12">

        <Label Grid.Row="0"
               Text="{Binding Title}"
               FontAttributes="Bold"
               FontSize="26"
               TextColor="White"
               HorizontalTextAlignment="Center"/>

        <HorizontalStackLayout Grid.Row="1" Spacing="10" HorizontalOptions="Center">
            <Button Text="Zurück" Command="{Binding BackCommand}" CornerRadius="14"/>
            <Button Text="Regeln" Command="{Binding LearnCommand}" CornerRadius="14"/>
            <Button Text="Einstellungen" Command="{Binding OpenSettingsCommand}" CornerRadius="14"/>
        </HorizontalStackLayout>

        <Border Grid.Row="2"
                BackgroundColor="#40FFFFFF"
                StrokeShape="RoundRectangle 18"
                Padding="12">

            <Grid>

                <ScrollView>
                    <Grid HeightRequest="{Binding MapHeight}">
                        <skia:SKLottieView Source="{Binding MapLottieSource}"
                                           RepeatCount="-1"
                                           HeightRequest="{Binding MapHeight}"
                                           HorizontalOptions="Fill"
                                           VerticalOptions="Fill"/>

                        <AbsoluteLayout BindableLayout.ItemsSource="{Binding LevelNodes}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid AbsoluteLayout.LayoutBounds="{Binding Bounds}"
                                          AbsoluteLayout.LayoutFlags="PositionProportional">

                                        <Border x:Name="NodeBorder"
                                                Stroke="#FFFFFF"
                                                StrokeThickness="2"
                                                BackgroundColor="#EAEAEA"
                                                StrokeShape="RoundRectangle 999">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding BindingContext.SelectLevelCommand, Source={x:Reference RootPage}}"
                                                    CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>

                                            <Label Text="{Binding LevelNumber}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   FontAttributes="Bold"
                                                   TextColor="#2B2B2B"/>
                                        </Border>

                                        <Image Source="professor.png"
                                               IsVisible="{Binding IsCurrent}"
                                               WidthRequest="26"
                                               HeightRequest="26"
                                               HorizontalOptions="End"
                                               VerticalOptions="Start"
                                               Margin="0,-10,-10,0"/>

                                        <Grid.Triggers>
                                            <DataTrigger TargetType="Grid" Binding="{Binding IsUnlocked}" Value="False">
                                                <Setter Property="Opacity" Value="0.35"/>
                                            </DataTrigger>

                                            <DataTrigger TargetType="Grid" Binding="{Binding IsCompleted}" Value="True">
                                                <Setter TargetName="NodeBorder" Property="BackgroundColor" Value="#03DAC5"/>
                                                <Setter TargetName="NodeBorder" Property="Stroke" Value="#03DAC5"/>
                                            </DataTrigger>

                                            <DataTrigger TargetType="Grid" Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="NodeBorder" Property="StrokeThickness" Value="3"/>
                                            </DataTrigger>
                                        </Grid.Triggers>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </AbsoluteLayout>
                    </Grid>
                </ScrollView>

                <!-- Settings Popup Overlay -->
                <Grid IsVisible="{Binding IsSettingsOpen}" BackgroundColor="#80000000">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CloseSettingsCommand}"/>
                    </Grid.GestureRecognizers>

                    <Border BackgroundColor="#FFFFFF"
                            StrokeShape="RoundRectangle 20"
                            Padding="16"
                            VerticalOptions="End"
                            Margin="0,0,0,8">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Schwierigkeit"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="#2B2B2B"/>

                            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="SpaceBetween">
                                <Button Text="Einfach" Command="{Binding SetDifficultyCommand}" CommandParameter="easy" Margin="0,0,8,8" CornerRadius="18"/>
                                <Button Text="Normal" Command="{Binding SetDifficultyCommand}" CommandParameter="normal" Margin="0,0,8,8" CornerRadius="18"/>
                                <Button Text="Schwer" Command="{Binding SetDifficultyCommand}" CommandParameter="hard" Margin="0,0,8,8" CornerRadius="18"/>
                                <Button Text="Kompliziert" Command="{Binding SetDifficultyCommand}" CommandParameter="complex" Margin="0,0,8,8" CornerRadius="18"/>
                                <Button Text="Master" Command="{Binding SetDifficultyCommand}" CommandParameter="master" Margin="0,0,8,8" CornerRadius="18"/>
                                <Button Text="Gott" Command="{Binding SetDifficultyCommand}" CommandParameter="god" Margin="0,0,8,8" CornerRadius="18"/>
                            </FlexLayout>

                            <Button Text="Schließen" Command="{Binding CloseSettingsCommand}" CornerRadius="14"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

            </Grid>
        </Border>

    </Grid>
</ContentPage>
