<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="LogikSpiel.View.GameLevelsPage"
    x:Name="RootPage"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#BB86FC" Offset="0"/>
            <GradientStop Color="#03DAC5" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="10" HorizontalOptions="Center" MaximumWidthRequest="720">
            <Label Text="{Binding Title}"
                   FontAttributes="Bold"
                   FontSize="{OnIdiom Phone=22, Tablet=28, Desktop=34}"
                   TextColor="White"
                   HorizontalTextAlignment="Center" />

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="Zurück" Command="{Binding BackCommand}" CornerRadius="14"/>
                <Button Text="Regeln" Command="{Binding LearnCommand}" CornerRadius="14"/>
            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Levels}"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="{Binding TileSpan}"
                                 HorizontalItemSpacing="12"
                                 VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#FFFFFF"
                            StrokeThickness="1"
                            BackgroundColor="#FFFFFF"
                            StrokeShape="RoundRectangle 18"
                            Padding="12">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                            <Label Text="{Binding LevelNumber, StringFormat='Level {0}'}"
                                   FontAttributes="Bold"
                                   TextColor="#2B2B2B"
                                   HorizontalTextAlignment="Center"/>

                            <Button Grid.Row="1"
                                    Text="Play"
                                    Command="{Binding BindingContext.PlayLevelCommand, Source={x:Reference RootPage}}"
                                    CommandParameter="{Binding .}"
                                    CornerRadius="14"
                                    HeightRequest="40"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
