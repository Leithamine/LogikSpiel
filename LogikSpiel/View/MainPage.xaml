<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="LogikSpiel.View.MainPage"
             x:Name="RootPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#BB86FC" Offset="0"/>
            <GradientStop Color="#03DAC5" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="8" HorizontalOptions="Center" MaximumWidthRequest="720">
            <Label Text="Logik Spiele"
                   FontAttributes="Bold"
                   FontSize="30"
                   TextColor="White"
                   HorizontalTextAlignment="Center"/>

            <Image Source="professor.png"
                   WidthRequest="190" HeightRequest="190"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"/>

            <skia:SKLottieView Source="lottie_intro.json"
                               HeightRequest="170"
                               RepeatCount="0"
                               HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Games}" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 18" Padding="12">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{Binding Title}"
                                   FontAttributes="Bold"
                                   TextColor="#2B2B2B"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="TailTruncation"/>
                            <Image Source="{Binding Image}" HeightRequest="120" Aspect="AspectFill"/>
                            <Button Text="Öffnen"
                                    Command="{Binding BindingContext.OpenGameCommand, Source={x:Reference RootPage}}"
                                    CommandParameter="{Binding .}"
                                    CornerRadius="14"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
