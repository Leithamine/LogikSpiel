<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LogikSpiel.ViewModel"
             xmlns:model="clr-namespace:LogikSpiel.Model"
             x:Class="LogikSpiel.View.MainPage"
             x:DataType="vm:MainPageViewModel"
             x:Name="RootPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundImageSource="gamebg.png">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- HEADER -->
        <Border Grid.Row="0"
                Style="{StaticResource GlassCard}"
                Margin="16,16,16,0"
                Padding="16,12">
            <Grid ColumnDefinitions="*,Auto">

                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <Border StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource C_Primary}"
                            WidthRequest="48" HeightRequest="48"
                            Padding="0">
                        <Label Text="🧩" FontSize="26"
                               TextColor="{StaticResource C_TextOnColor}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label Text="Logik Spiele" Style="{StaticResource H3}"/>
                        <Label Text="Trainiere dein Gehirn" Style="{StaticResource Caption}"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                    <Border Style="{StaticResource Chip}">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="💰" FontSize="16"/>
                            <Label Text="{Binding Coins}"
                                   TextColor="{StaticResource C_GoldDark}"
                                   FontAttributes="Bold"
                                   FontSize="15"/>
                        </HorizontalStackLayout>
                    </Border>

                    <Border StrokeShape="RoundRectangle 22"
                            Stroke="{StaticResource C_Primary}"
                            StrokeThickness="2"
                            WidthRequest="44" HeightRequest="44"
                            Padding="0"
                            BackgroundColor="{StaticResource C_GlassSoft}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenProfileCommand}"/>
                        </Border.GestureRecognizers>
                        <Image Source="professor.png" Aspect="AspectFill"/>
                    </Border>
                </HorizontalStackLayout>

            </Grid>
        </Border>

        <!-- CONTENT -->
        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="20">

                <VerticalStackLayout Spacing="8" Margin="0,10,0,0">
                    <Label Text="👋 Willkommen zurück!" Style="{StaticResource H1}" HorizontalOptions="Center"/>
                    <Label Text="Wähle ein Spiel und starte!" Style="{StaticResource Body}" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 30"
                        BackgroundColor="{StaticResource C_GlassHighlight}"
                        WidthRequest="160" HeightRequest="160"
                        HorizontalOptions="Center"
                        Shadow="{StaticResource ShadowGlowBlue}">
                    <Grid>
                        <Image Source="applogo.png"
                               WidthRequest="140" HeightRequest="140"
                               Aspect="AspectFit"/>
                    </Grid>
                </Border>

                <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
                    <BoxView WidthRequest="4" HeightRequest="24"
                             Color="{StaticResource C_Primary}"
                             CornerRadius="2"/>
                    <Label Text="Spiele" Style="{StaticResource H2}"/>
                </HorizontalStackLayout>

                <FlexLayout Wrap="Wrap"
                            JustifyContent="SpaceBetween"
                            AlignItems="Start"
                            BindableLayout.ItemsSource="{Binding Games}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="model:GameDefinition">
                            <Border Style="{StaticResource SolidCard}"
                                    WidthRequest="165"
                                    Margin="0,0,0,16">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenGameCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="12">

                                    <Border StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14"
                                            HeightRequest="100"
                                            BackgroundColor="{StaticResource C_GlassSoft}">
                                        <Image Source="{Binding Image}"
                                               Aspect="AspectFit"
                                               Margin="10"/>
                                    </Border>

                                    <Label Text="{Binding Title}"
                                           Style="{StaticResource H3}"
                                           FontSize="15"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="TailTruncation"/>

                                    <Button Text="▶ Spielen"
                                            Style="{StaticResource BtnPrimary}"
                                            HeightRequest="42"
                                            FontSize="14"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenGameCommand}"
                                            CommandParameter="{Binding .}"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
