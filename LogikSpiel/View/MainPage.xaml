<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
    x:Class="LogikSpiel.View.MainPage"
    x:Name="RootPage"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#BB86FC" Offset="0"/>
            <GradientStop Color="#03DAC5" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="8" HorizontalOptions="Center" MaximumWidthRequest="720">
            <Label Text="{Binding PageTitle}"
                   FontAttributes="Bold"
                   FontSize="{OnIdiom Phone=26, Tablet=32, Desktop=38}"
                   TextColor="White"
                   HorizontalTextAlignment="Center" />

            <Image Source="professor.png"
                   WidthRequest="{OnIdiom Phone=200, Tablet=220, Desktop=250}"
                   HeightRequest="{OnIdiom Phone=200, Tablet=230, Desktop=250}"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   Margin="0,0,0,-6"/>

            <skia:SKLottieView Source="lottie_intro.json"
                               HeightRequest="{OnIdiom Phone=200, Tablet=250, Desktop=300}"
                               Scale="1.5"
                               HorizontalOptions="Center"
                               RepeatCount="0"/>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Games}"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="{Binding TileSpan}"
                                 HorizontalItemSpacing="12"
                                 VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#FFFFFF"
                            StrokeThickness="1"
                            BackgroundColor="#FFFFFF"
                            StrokeShape="RoundRectangle 18"
                            Padding="12">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">

                            <Label Text="{Binding Title}"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   TextColor="#2B2B2B"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="TailTruncation"/>

                            <Border Grid.Row="1"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14">
                                <Image Source="{Binding Image}"
                                       Aspect="AspectFill"
                                       HeightRequest="{OnIdiom Phone=110, Tablet=140, Desktop=160}"/>
                            </Border>

                            <Button Grid.Row="2"
                                    Text="Öffnen"
                                    Command="{Binding BindingContext.OpenGameCommand, Source={x:Reference RootPage}}"
                                    CommandParameter="{Binding .}"
                                    CornerRadius="14"
                                    HeightRequest="40"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
