<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="LogikSpiel.View.MainPage"
             x:Name="RootPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#BB86FC" Offset="0"/>
            <GradientStop Color="#03DAC5" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *" RowSpacing="0">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" HeightRequest="60" Padding="15,0" BackgroundColor="#20000000">
            <Label Grid.Column="0" Text="Logik Spiele" TextColor="White" FontAttributes="Bold" FontSize="20" VerticalOptions="Center"/>

            <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center">
                <Label Text="{Binding Coins, StringFormat='💰 {0}'}" TextColor="#FFD700" FontAttributes="Bold" FontSize="16" VerticalOptions="Center"/>
                <Border StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40" Padding="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenProfileCommand}"/>
                    </Border.GestureRecognizers>
                    <Image Source="professor.png" Aspect="AspectFill"/>
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Games}" SelectionMode="None" Margin="10,0">

            <CollectionView.Header>
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center" Padding="0,10,0,20">

                    <Label Text="Willkommen zurück!"
                           FontAttributes="Bold"
                           FontSize="26"
                           TextColor="White"
                           HorizontalTextAlignment="Center"/>

                    <Image Source="professor.png"
                           WidthRequest="160" HeightRequest="160"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"/>

                    <skia:SKLottieView Source="lottie_intro.json"
                                       HeightRequest="150"
                                       RepeatCount="0"
                                       HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" 
                                 Span="2" 
                                 HorizontalItemSpacing="10" 
                                 VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 18" Padding="10">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Title}" 
                                   FontAttributes="Bold" 
                                   TextColor="#2B2B2B" 
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="TailTruncation"/>

                            <Image Source="{Binding Image}" 
                                   HeightRequest="100" 
                                   Aspect="AspectFill"/>

                            <Button Text="Spielen" 
                                    Command="{Binding BindingContext.OpenGameCommand, Source={x:Reference RootPage}}" 
                                    CommandParameter="{Binding .}" 
                                    CornerRadius="14"
                                    HeightRequest="40"
                                    FontSize="14"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
</ContentPage>