<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LogikSpiel.View.LearnPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#BB86FC" Offset="0"/>
            <GradientStop Color="#03DAC5" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="10" HeightRequest="60" BackgroundColor="#20000000">
        <Button Grid.Column="0" Text="Zurück" Command="{Binding BackCommand}" BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold"/>

        <Label Grid.Column="1" Text="{Binding Title}" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center"/>

        <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
            <Label Text="{Binding Coins, StringFormat='💰 {0}'}" TextColor="#FFD700" FontAttributes="Bold" VerticalOptions="Center"/>
            <Border StrokeShape="RoundRectangle 18" WidthRequest="36" HeightRequest="36" Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenProfileCommand}"/>
                </Border.GestureRecognizers>
                <Image Source="professor.png" Aspect="AspectFill"/>
            </Border>
        </HorizontalStackLayout>
    

    <Border Grid.Row="1" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 18" Padding="14">
            <CollectionView ItemsSource="{Binding Rules}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="•  {Binding .}" TextColor="#2B2B2B" Margin="0,6"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>
</ContentPage>
