<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LogikSpiel.ViewModel"
             xmlns:resx="clr-namespace:LogikSpiel.Resources.Strings"
             x:Class="LogikSpiel.View.LearnPage"
             x:DataType="vm:LearnPageViewModel"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundImageSource="gamebg.png">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="16">

        <Border Style="{StaticResource GlassCard}" Padding="12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Text="{resx:Translate Key=Common_BackArrow}" Style="{StaticResource BtnIcon}"
                        Command="{Binding BackCommand}"/>

                <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource H3}"
                       HorizontalOptions="Center" VerticalOptions="Center"/>

                <Border Grid.Column="2" Style="{StaticResource Chip}">
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="💰" FontSize="14"/>
                        <Label Text="{Binding Coins}" TextColor="{StaticResource C_GoldDark}" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="20">
            <ScrollView>
                <VerticalStackLayout Spacing="16">

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="📚" FontSize="24"/>
                        <Label Text="{resx:Translate Key=Learn_RulesTitle}" Style="{StaticResource H2}"/>
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource C_Divider}"/>

                    <CollectionView ItemsSource="{Binding Rules}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{StaticResource C_GlassSoft}"
                                        Padding="14"
                                        Margin="0,4">
                                    <HorizontalStackLayout Spacing="12">
                                        <Label Text="•"
                                               TextColor="{StaticResource C_Primary}"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               VerticalOptions="Start"/>
                                        <Label Text="{Binding .}"
                                               Style="{StaticResource Body}"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </Border>

    </Grid>
</ContentPage>
