<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LogikSpiel.ViewModel"
             x:Class="LogikSpiel.View.OnboardingPage"
             x:DataType="vm:OnboardingViewModel" 
             BackgroundColor="#BB86FC">
    <Grid RowDefinitions="*,Auto" Padding="30">
        <VerticalStackLayout Spacing="20" VerticalOptions="Center">
            <Label Text="Willkommen!" FontSize="32" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
            <Label Text="Verrate uns, wer du bist." TextColor="White" HorizontalOptions="Center"/>

            <Image Source="professor.png" HeightRequest="150" HorizontalOptions="Center"/>

            <Border StrokeShape="RoundRectangle 10" BackgroundColor="White" Padding="5">
                <Entry Placeholder="Dein Name" Text="{Binding Name}" TextColor="Black" FontSize="18"/>
            </Border>

            <Border StrokeShape="RoundRectangle 10" BackgroundColor="White" Padding="5">
                <Entry Placeholder="Dein Alter (5-99)" Text="{Binding AgeText}" Keyboard="Numeric" TextColor="Black" FontSize="18"/>
            </Border>
        </VerticalStackLayout>

        <Button Grid.Row="1" 
                Text="Los geht's!"
                Command="{Binding CompleteOnboardingCommand}"
                BackgroundColor="#03DAC5"
                TextColor="Black"
                FontAttributes="Bold"
                CornerRadius="25"
                HeightRequest="60"
                IsEnabled="{Binding IsValid}"/>
    </Grid>
</ContentPage>