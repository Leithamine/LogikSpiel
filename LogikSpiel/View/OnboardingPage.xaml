<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LogikSpiel.ViewModel"
             x:Class="LogikSpiel.View.OnboardingPage"
             x:DataType="vm:OnboardingViewModel"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundImageSource="gamebg.png">

    <Grid RowDefinitions="*,Auto" Padding="24">

        <ScrollView VerticalOptions="Center">
            <VerticalStackLayout Spacing="24" MaximumWidthRequest="420" HorizontalOptions="Center">

                <VerticalStackLayout Spacing="8">
                    <Label Text="👋 Willkommen!"
                           Style="{StaticResource H1}"
                           HorizontalOptions="Center"/>
                    <Label Text="Erstelle dein Profil und starte die Reise!"
                           Style="{StaticResource Body}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 90"
                        WidthRequest="180" HeightRequest="180"
                        BackgroundColor="{StaticResource C_GlassHighlight}"
                        HorizontalOptions="Center"
                        Shadow="{StaticResource ShadowGlowBlue}">
                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 85"
                            WidthRequest="170" HeightRequest="170"
                            BackgroundColor="{StaticResource C_GlassSoft}"
                            HorizontalOptions="Center" VerticalOptions="Center">
                        <Image Source="professor.png"
                               WidthRequest="150" HeightRequest="150"
                               Aspect="AspectFit"/>
                    </Border>
                </Border>
                <VerticalStackLayout Spacing="16">
                    <Border Style="{StaticResource GlassCard}" Padding="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource C_Primary}"
                                    WidthRequest="48" HeightRequest="48"
                                    Padding="0">
                                <Label Text="👤" FontSize="22"
                                       TextColor="{StaticResource C_TextOnColor}"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Entry Grid.Column="1"
                                   Placeholder="Dein Name"
                                   Text="{Binding Name}"
                                   TextColor="{StaticResource C_TextPrimary}"
                                   PlaceholderColor="{StaticResource C_TextMuted}"
                                   FontSize="18"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Padding="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource C_Accent}"
                                    WidthRequest="48" HeightRequest="48"
                                    Padding="0">
                                <Label Text="🎂" FontSize="22"
                                       TextColor="{StaticResource C_TextPrimary}"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Entry Grid.Column="1"
                                   Placeholder="Dein Alter (5-99)"
                                   Text="{Binding AgeText}"
                                   Keyboard="Numeric"
                                   TextColor="{StaticResource C_TextPrimary}"
                                   PlaceholderColor="{StaticResource C_TextMuted}"
                                   FontSize="18"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="1"
                Text="🚀 Los geht's!"
                Command="{Binding CompleteOnboardingCommand}"
                IsEnabled="{Binding IsValid}"
                HeightRequest="60"
                FontSize="18"
                Margin="0,20,0,0"
                BackgroundColor="{StaticResource C_Primary}"
                TextColor="{StaticResource C_TextOnColor}"
                CornerRadius="16"
                Shadow="{StaticResource ShadowMedium}"/>

    </Grid>
</ContentPage>
