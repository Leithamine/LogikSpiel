<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             xmlns:vm="clr-namespace:LogikSpiel.ViewModel"
             x:Class="LogikSpiel.View.GameMapPage"
             x:DataType="vm:GameMapPageViewModel"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#BB86FC" Offset="0"/>
            <GradientStop Color="#03DAC5" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="10" HeightRequest="60" BackgroundColor="#20000000">
            <Button Grid.Column="0" Text="Zurück" Command="{Binding BackCommand}" 
                    BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold"/>

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0" HorizontalOptions="Center">
                <Label Text="{Binding Title}" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center"/>
                <Label Text="{Binding DifficultyLabel}" TextColor="#DDD" FontSize="12" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">

                <Button Text="Lernen" Command="{Binding RulesCommand}" 
                        WidthRequest="35" HeightRequest="35" Padding="0" 
                        BackgroundColor="#40FFFFFF" CornerRadius="8" FontAttributes="Bold"/>
                
                <Button Text="⚙️" Command="{Binding ToggleSettingsCommand}" 
                        WidthRequest="35" HeightRequest="35" Padding="0" 
                        BackgroundColor="#40FFFFFF" CornerRadius="8"/>

                <Label Text="{Binding Coins, StringFormat='💰 {0}'}" 
                       TextColor="#FFD700" FontAttributes="Bold" VerticalOptions="Center"/>
                <Border StrokeShape="RoundRectangle 18" WidthRequest="36" HeightRequest="36" Padding="0" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenProfileCommand}"/>
                    </Border.GestureRecognizers>
                    <Image Source="professor.png" Aspect="AspectFill"/>
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1" x:Name="MapScrollView" VerticalScrollBarVisibility="Never">
            <Grid HeightRequest="{Binding MapHeight}">

                <skia:SKLottieView x:Name="BackgroundLottie"
                                   Source="{Binding MapLottieSource}"
                                   RepeatCount="-1"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill"
                                   InputTransparent="True"/>

                <GraphicsView x:Name="PathView"
                              InputTransparent="True"
                              HorizontalOptions="Fill" 
                              VerticalOptions="Fill" />

                <AbsoluteLayout BindableLayout.ItemsSource="{Binding Nodes}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:LevelNodeViewModel">
                            <Grid AbsoluteLayout.LayoutBounds="{Binding Bounds}"
                                  AbsoluteLayout.LayoutFlags="PositionProportional"
                                  WidthRequest="60" HeightRequest="60">

                                <Border Stroke="#FFFFFF" StrokeThickness="2" BackgroundColor="#EAEAEA"
                                        StrokeShape="RoundRectangle 30"
                                        WidthRequest="50" HeightRequest="50"
                                        HorizontalOptions="Center" VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GameMapPageViewModel}}, Path=OpenLevelCommand}"
                                                              CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding LevelNumber}" 
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           FontAttributes="Bold" TextColor="#2B2B2B"/>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#03DAC5"/>
                                            <Setter Property="Stroke" Value="#03DAC5"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="StrokeThickness" Value="4"/>
                                            <Setter Property="Stroke" Value="#FFD700"/>
                                            <Setter Property="Scale" Value="1.15"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                </Border>

                                <Image Source="professor.png" IsVisible="{Binding IsCurrent}"
                                       WidthRequest="32" HeightRequest="32"
                                       HorizontalOptions="End" VerticalOptions="Start"
                                       Margin="0,-12,-12,0"/>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </AbsoluteLayout>

                <AbsoluteLayout InputTransparent="True">
                    <Image Source="wolke.png"
                           Aspect="Fill" 
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill"
                           AbsoluteLayout.LayoutBounds="{Binding CloudBounds}"
                           AbsoluteLayout.LayoutFlags="PositionProportional,WidthProportional"/>
                </AbsoluteLayout>
            </Grid>
        </ScrollView>

        <Grid Grid.Row="1" IsVisible="{Binding IsSettingsOpen}" BackgroundColor="#CC000000" Padding="20">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleSettingsCommand}"/>
            </Grid.GestureRecognizers>
            <Border BackgroundColor="White" VerticalOptions="Center" StrokeShape="RoundRectangle 20" Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Schwierigkeit wählen" FontAttributes="Bold" FontSize="18" TextColor="Black" HorizontalOptions="Center"/>
                    <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" Direction="Row">
                        <Button Text="Einfach" Command="{Binding ChangeDifficultyCommand}" CommandParameter="easy" WidthRequest="100" Margin="5"/>
                        <Button Text="Normal" Command="{Binding ChangeDifficultyCommand}" CommandParameter="normal" WidthRequest="100" Margin="5"/>
                        <Button Text="Schwer" Command="{Binding ChangeDifficultyCommand}" CommandParameter="hard" WidthRequest="100" Margin="5"/>
                        <Button Text="Master" Command="{Binding ChangeDifficultyCommand}" CommandParameter="master" WidthRequest="100" Margin="5"/>
                    </FlexLayout>
                    <Button Text="Abbrechen" Command="{Binding ToggleSettingsCommand}" BackgroundColor="#EEE" TextColor="Black"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>