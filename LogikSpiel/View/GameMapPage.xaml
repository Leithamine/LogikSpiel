<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="LogikSpiel.View.GameMapPage"
             x:Name="RootPage"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#BB86FC" Offset="0"/>
            <GradientStop Color="#03DAC5" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="12">

        <!-- Titel -->
        <VerticalStackLayout Grid.Row="0" Spacing="6" HorizontalOptions="Center" MaximumWidthRequest="720">
            <Label Text="{Binding Title}"
                   FontAttributes="Bold"
                   FontSize="{OnIdiom Phone=24, Tablet=30, Desktop=36}"
                   TextColor="White"
                   HorizontalTextAlignment="Center"/>

            <Label Text="{Binding DifficultyLabel}"
                   FontSize="14"
                   TextColor="#EFFFFFFF"
                   HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>

        <!-- Buttons -->
        <HorizontalStackLayout Grid.Row="1" Spacing="10" HorizontalOptions="Center">
            <Button Text="Zurück" Command="{Binding BackCommand}" CornerRadius="14"/>
            <Button Text="Regeln" Command="{Binding RulesCommand}" CornerRadius="14"/>
            <Button Text="Einstellungen" Command="{Binding SettingsCommand}" CornerRadius="14"/>
        </HorizontalStackLayout>

        <!-- Map -->
        <ScrollView Grid.Row="2">
            <Grid HeightRequest="{Binding MapHeight}">
                <!-- Lottie Weg -->
                <skia:SKLottieView Source="{Binding MapLottieSource}"
                                   RepeatCount="-1"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill"
                                   HeightRequest="{Binding MapHeight}" />

                <!-- Level Nodes Overlay -->
                <AbsoluteLayout BindableLayout.ItemsSource="{Binding Nodes}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid AbsoluteLayout.LayoutBounds="{Binding Bounds}"
                                  AbsoluteLayout.LayoutFlags="PositionProportional">

                                <Border x:Name="NodeBorder"
                                        Stroke="#FFFFFF"
                                        StrokeThickness="2"
                                        BackgroundColor="#EAEAEA"
                                        StrokeShape="RoundRectangle 999">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.OpenLevelCommand, Source={x:Reference RootPage}}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>

                                    <Label Text="{Binding LevelNumber}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           FontAttributes="Bold"
                                           TextColor="#2B2B2B"/>
                                </Border>

                                <Image Source="professor.png"
                                       IsVisible="{Binding IsCurrent}"
                                       WidthRequest="26"
                                       HeightRequest="26"
                                       HorizontalOptions="End"
                                       VerticalOptions="Start"
                                       Margin="0,-10,-10,0"/>

                                <!-- States -->
                                <Grid.Triggers>
                                    <DataTrigger TargetType="Grid" Binding="{Binding IsUnlocked}" Value="False">
                                        <Setter Property="Opacity" Value="0.35"/>
                                    </DataTrigger>

                                    <DataTrigger TargetType="Grid" Binding="{Binding IsCompleted}" Value="True">
                                        <Setter TargetName="NodeBorder" Property="BackgroundColor" Value="#03DAC5"/>
                                        <Setter TargetName="NodeBorder" Property="Stroke" Value="#03DAC5"/>
                                    </DataTrigger>

                                    <DataTrigger TargetType="Grid" Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="NodeBorder" Property="StrokeThickness" Value="3"/>
                                    </DataTrigger>
                                </Grid.Triggers>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </AbsoluteLayout>
            </Grid>
        </ScrollView>

    </Grid>
</ContentPage>
