<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LogikSpiel.ViewModel"
             xmlns:resx="clr-namespace:LogikSpiel.Resources.Strings"
             xmlns:conv="clr-namespace:LogikSpiel.Converters"
             x:Class="LogikSpiel.View.MathCrossPage"
             x:DataType="vm:MathCrossPageViewModel"
             x:Name="ThisPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundImageSource="gamebg.png">
    <ContentPage.Resources>
        <conv:MathCellToColorConverter x:Key="MathCellToColorConverter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Padding="12" RowSpacing="12">
        <Border Style="{StaticResource GlassCard}" Padding="{OnIdiom Phone=8, Desktop=12}" Margin="0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                <Button Grid.Column="0" Text="&#x2302;" Style="{StaticResource BtnIcon}" WidthRequest="76" HeightRequest="40" Padding="10,0" Command="{Binding BackCommand}" IsEnabled="{Binding IsNotBusy}"/>

                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                    <Label Text="{Binding GameTitle}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource C_TextPrimary}" LineBreakMode="TailTruncation"/>
                    <Label Text="{Binding HeaderSubtitle}" FontSize="12" TextColor="{StaticResource C_TextMuted}" LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>

                <Border Grid.Column="2" Style="{StaticResource CoinBadge}" Padding="8">
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="&#x1F4B0;" FontSize="14"/>
                        <Label Text="{Binding Coins}" TextColor="{StaticResource C_Gold}" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                </Border>

                <Button Grid.Column="3" Text="💡" Style="{StaticResource BtnGhost}" HeightRequest="40" WidthRequest="44" Command="{Binding HintCommand}" IsEnabled="{Binding CanUseLamp}"/>
                <Button Grid.Column="4" Text="↶" Style="{StaticResource BtnGhost}" HeightRequest="40" WidthRequest="44" Command="{Binding UndoCommand}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource GlassCard}" x:Name="BoardContainer" Padding="8" VerticalOptions="Fill">
            <Grid x:Name="BoardGrid" HorizontalOptions="Center" VerticalOptions="Center" RowSpacing="4" ColumnSpacing="4"/>
        </Border>

        <Border Grid.Row="2" x:Name="NumberBankContainer" Style="{StaticResource SolidCard}" Padding="16,12" VerticalOptions="End">
            <Border.GestureRecognizers>
                <DropGestureRecognizer AllowDrop="True" Drop="OnBankDrop"/>
            </Border.GestureRecognizers>
            <FlexLayout Direction="Row"
                        Wrap="Wrap"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        BindableLayout.ItemsSource="{Binding NumberBank}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:NumberBankTileViewModel">
                        <Border Margin="0,0,8,8"
                                Opacity="{Binding TileOpacity}"
                                Scale="{Binding TileScale}"
                                ZIndex="{Binding TileZIndex}"
                                Padding="8,0"
                                HeightRequest="52"
                                WidthRequest="{Binding TileWidth}"
                                VerticalOptions="Center"
                                BackgroundColor="{StaticResource C_BgLight}"
                                Stroke="{StaticResource C_Primary}"
                                StrokeThickness="1.3"
                                StrokeShape="RoundRectangle 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.NumberTileTappedCommand}" CommandParameter="{Binding .}"/>
                                <DragGestureRecognizer DragStarting="OnTileDragStarting" DropCompleted="OnTileDropCompleted"/>
                            </Border.GestureRecognizers>
                            <Label Text="{Binding DisplayValue}"
                                   FontAttributes="Bold"
                                   FontSize="19"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   LineBreakMode="NoWrap"/>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </Border>

        <Grid Grid.RowSpan="3" IsVisible="{Binding IsBusy}" BackgroundColor="#DD000000" InputTransparent="False">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                <ActivityIndicator IsRunning="True" Color="{StaticResource C_Primary}" HeightRequest="60" WidthRequest="60"/>
                <Label Text="{resx:Translate Key=MathCross_Generating}" Style="{StaticResource H3}"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
