<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
    x:Class="LogikSpiel.View.GameHostPage"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#BB86FC" Offset="0"/>
            <GradientStop Color="#03DAC5" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="8" HorizontalOptions="Center" MaximumWidthRequest="720">
            <Label Text="{Binding Title}"
                   FontAttributes="Bold"
                   FontSize="{OnIdiom Phone=22, Tablet=28, Desktop=34}"
                   TextColor="White"
                   HorizontalTextAlignment="Center" />

            <Image Source="professor.png"
                   WidthRequest="{OnIdiom Phone=180, Tablet=200, Desktop=220}"
                   HeightRequest="{OnIdiom Phone=180, Tablet=200, Desktop=220}"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   Margin="0,0,0,-6"/>

            <skia:SKLottieView Source="lottie_intro.json"
                               HeightRequest="{OnIdiom Phone=160, Tablet=200, Desktop=240}"
                               Scale="1.2"
                               HorizontalOptions="Center"
                               RepeatCount="0"/>

            <Button Text="Zurück" Command="{Binding BackCommand}" CornerRadius="14"/>
        </VerticalStackLayout>

        <Border Grid.Row="1" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 18" Padding="14">
            <VerticalStackLayout Spacing="8">
                <Label Text="GameHost Platzhalter"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#2B2B2B"/>
                <Label Text="Hier kommt später deine Spiele-UI / Logik rein."
                       TextColor="#2B2B2B"/>
                <Label Text="{Binding Spec, StringFormat='Spec: {0}'}"
                       TextColor="#2B2B2B"
                       FontSize="12"/>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
