<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="LogikSpiel.View.GameHostPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#BB86FC" Offset="0"/>
            <GradientStop Color="#03DAC5" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="8" HorizontalOptions="Center" MaximumWidthRequest="720">
            <Label Text="{Binding Title}"
                   FontAttributes="Bold"
                   FontSize="20"
                   TextColor="White"
                   HorizontalTextAlignment="Center"/>

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="Zurück" Command="{Binding BackCommand}" CornerRadius="14"/>
                <Button Text="Regeln" Command="{Binding RulesCommand}" CornerRadius="14"/>
                <Button Text="Lösen ✅" Command="{Binding SolveCommand}" CornerRadius="14"/>
            </HorizontalStackLayout>

            <Image Source="professor.png" WidthRequest="160" HeightRequest="160" Aspect="AspectFit"/>

            <skia:SKLottieView Source="lottie_intro.json"
                               HeightRequest="160"
                               RepeatCount="0"
                               HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <Border Grid.Row="1" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 18" Padding="14">
            <Label Text="Hier kommt später deine echte Rätsel-UI rein. 'Lösen' markiert das Level als geschafft und lädt automatisch das nächste."
                   TextColor="#2B2B2B"/>
        </Border>

    </Grid>
</ContentPage>
