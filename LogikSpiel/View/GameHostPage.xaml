<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LogikSpiel.ViewModel"
             xmlns:resx="clr-namespace:LogikSpiel.Resources.Strings"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="LogikSpiel.View.GameHostPage"
             x:DataType="vm:GameHostPageViewModel"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource BgGradient}">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="16">

        <!-- ═══════════════════════════════════════════════════════════════
             HEADER
             ═══════════════════════════════════════════════════════════════ -->
        <Border Style="{StaticResource GlassCard}" Padding="12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Text="{resx:Translate Key=Common_Back}" Style="{StaticResource BtnIcon}"
                        Command="{Binding BackCommand}"/>

                <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource H3}"
                       HorizontalOptions="Center" VerticalOptions="Center"/>

                <HorizontalStackLayout Grid.Column="2" Spacing="8">
                    <Button Text="📖" Style="{StaticResource BtnIcon}"
                            WidthRequest="40" HeightRequest="40"
                            Command="{Binding RulesCommand}"/>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             GAME CONTENT
             ═══════════════════════════════════════════════════════════════ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="24" HorizontalOptions="Center" MaximumWidthRequest="500">

                <!-- Mascot -->
                <Border StrokeThickness="0" 
                        StrokeShape="RoundRectangle 80"
                        WidthRequest="160" HeightRequest="160"
                        HorizontalOptions="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource C_Primary}" Offset="0"/>
                            <GradientStop Color="{StaticResource C_Secondary}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Image Source="professor.png" 
                           WidthRequest="140" HeightRequest="140" 
                           Aspect="AspectFit"/>
                </Border>

                <!-- Lottie Animation -->
                <skia:SKLottieView Source="lottie_intro.json"
                                   HeightRequest="140"
                                   RepeatCount="0"
                                   HorizontalOptions="Center"/>

                <!-- Info Card -->
                <Border Style="{StaticResource SolidCard}" Padding="20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{resx:Translate Key=GameHost_InfoTitle}" Style="{StaticResource H3}"/>
                        <Label Text="{resx:Translate Key=GameHost_InfoBody}"
                               Style="{StaticResource Body}"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Action Buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Grid.Column="0" Text="{resx:Translate Key=GameHost_RulesButton}"
                            Style="{StaticResource BtnSecondary}"
                            Command="{Binding RulesCommand}"/>

                    <Button Grid.Column="1" Text="{resx:Translate Key=GameHost_SolveButton}"
                            Style="{StaticResource BtnSuccess}"
                            Command="{Binding SolveCommand}"/>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
