<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LogikSpiel.ViewModel"
             x:Class="LogikSpiel.View.MathHangmanPage"
             x:DataType="vm:MathHangmanPageViewModel"
             x:Name="ThisPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundImageSource="gamebg.png">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="12" RowSpacing="12">
        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Text="←" Style="{StaticResource BtnIcon}"
                        Command="{Binding BackCommand}"/>

                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="🎯 Mathe-Hangman" Style="{StaticResource H3}" HorizontalOptions="Center"/>
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 8"
                            BackgroundColor="{StaticResource C_Accent}" Padding="10,4">
                        <Label Text="{Binding DifficultyText}" TextColor="{StaticResource C_TextDark}" FontSize="11" FontAttributes="Bold"/>
                    </Border>
                </VerticalStackLayout>
                <Border Grid.Column="2" Style="{StaticResource CoinBadge}">
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="💰" FontSize="14"/>
                        <Label Text="{Binding Coins}" TextColor="{StaticResource C_Gold}" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>

        <!-- HANGMAN -->
        <Border Grid.Row="1" Style="{StaticResource GlowCard}" HeightRequest="260">
            <Grid RowDefinitions="Auto,*" RowSpacing="10">

                <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="❤️" FontSize="18"/>
                        <Label Text="{Binding Lives}" Style="{StaticResource H3}" 
                               TextColor="{StaticResource C_Accent}"/>
                    </HorizontalStackLayout>

                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 8"
                            BackgroundColor="{StaticResource C_Error}" Padding="10,4"
                            Opacity="0.9">
                        <Label Text="{Binding WrongCount, StringFormat='Fehler: {0}/6'}" 
                               TextColor="{StaticResource C_TextPrimary}" FontSize="12" FontAttributes="Bold"/>
                    </Border>
                </HorizontalStackLayout>

                <Border Grid.Row="1" 
                        StrokeThickness="0" 
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource C_BgDark}">
                    <GraphicsView x:Name="HangmanView"
                                  HorizontalOptions="Fill"
                                  VerticalOptions="Fill"/>
                </Border>
            </Grid>
        </Border>

        <!-- PROPERTIES -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="12">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">

                <Label Text="✨ Eigenschaften der Zahl" Style="{StaticResource H3}"/>

                <Border Grid.Row="1"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="12"
                        IsVisible="{Binding HasHint}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{StaticResource C_Warning}" Offset="0"/>
                            <GradientStop Color="{StaticResource C_GoldDark}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Label Text="{Binding CurrentHint}" 
                           TextColor="{StaticResource C_TextDark}" 
                           FontAttributes="Bold" 
                           FontSize="14"/>
                </Border>

                <!-- Properties List -->
                <CollectionView Grid.Row="2" ItemsSource="{Binding VisibleProperties}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:NumberPropertyVM">
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{StaticResource C_BgLight}"
                                    Padding="14"
                                    Margin="0,4">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                        <Label Text="✓" TextColor="{StaticResource C_Success}" 
                                               FontSize="16" FontAttributes="Bold"/>
                                        <Label Text="{Binding Key}" 
                                               TextColor="{StaticResource C_TextPrimary}"
                                               FontAttributes="Bold"
                                               FontSize="14"/>
                                    </HorizontalStackLayout>

                                    <Button Grid.Column="1" Text="?" 
                                            WidthRequest="38" HeightRequest="38"
                                            CornerRadius="19"
                                            BackgroundColor="{StaticResource C_Primary}"
                                            TextColor="{StaticResource C_TextPrimary}"
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            Padding="0"
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ExplainPropertyCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <!-- INPUT -->
        <Border Grid.Row="3" Style="{StaticResource SolidCard}" Padding="16">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">

                <Border StrokeThickness="2" 
                        Stroke="{StaticResource C_Primary}"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{StaticResource C_BgLight}"
                        Padding="4">
                    <Entry Text="{Binding GuessText}"
                           Placeholder="Zahl eingeben..."
                           Keyboard="Numeric"
                           BackgroundColor="Transparent"
                           TextColor="{StaticResource C_TextPrimary}"
                           PlaceholderColor="{StaticResource C_TextMuted}"
                           FontSize="18"
                           FontAttributes="Bold"/>
                </Border>

                <Button Grid.Column="1" Text="✓"
                        Style="{StaticResource BtnSuccess}"
                        WidthRequest="56" HeightRequest="52"
                        FontSize="22"
                        Command="{Binding GuessCommand}"/>

                <Button Grid.Column="2" Text="💡"
                        BackgroundColor="{StaticResource C_Warning}"
                        TextColor="{StaticResource C_TextDark}"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        WidthRequest="56" HeightRequest="52"
                        FontSize="22"
                        Command="{Binding HintCommand}"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
