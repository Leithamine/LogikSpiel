<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LogikSpiel.ViewModel"
             x:Class="LogikSpiel.View.MathHangmanPage"
             x:DataType="vm:MathHangmanPageViewModel"
             x:Name="ThisPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundImageSource="gamebg.png">

    <Grid x:Name="RootLayout" RowDefinitions="Auto,Auto,*,Auto" Padding="12" RowSpacing="12">
        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Text="Zurück" Style="{StaticResource BtnIcon}"
                        WidthRequest="88"
                        HeightRequest="48"
                        Padding="12,0"
                        Command="{Binding BackCommand}"/>

                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="🎯 Mathe-Hangman" Style="{StaticResource H3}" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <Border Grid.Column="2" Style="{StaticResource CoinBadge}">
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="💰" FontSize="14"/>
                        <Label Text="{Binding Coins}" TextColor="{StaticResource C_Gold}" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>

        <!-- HANGMAN -->
        <Border Grid.Row="1" Style="{StaticResource GlowCard}" HeightRequest="260">
            <Grid RowDefinitions="Auto,*" RowSpacing="10">

                <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="❤️" FontSize="18"/>
                        <Label Text="{Binding Lives}" Style="{StaticResource H3}" 
                               TextColor="{StaticResource C_Accent}"/>
                    </HorizontalStackLayout>
                </HorizontalStackLayout>

                <Border Grid.Row="1" 
                        StrokeThickness="0" 
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource C_BgDark}">
                    <GraphicsView x:Name="HangmanView"
                                  HorizontalOptions="Fill"
                                  VerticalOptions="Fill"/>
                </Border>
            </Grid>
        </Border>

        <!-- PROPERTIES -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="12">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">

                <Label Text="✨ Eigenschaften der Zahl" Style="{StaticResource H3}"/>
                <VerticalStackLayout Grid.Row="1" Spacing="6">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 8"
                            BackgroundColor="{StaticResource C_Accent}" Padding="10,4">
                        <Label Text="{Binding DifficultyText}" TextColor="{StaticResource C_TextDark}" FontSize="18" FontAttributes="Bold"/>
                    </Border>
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 8"
                            BackgroundColor="{StaticResource C_Accent}" Padding="10,4">
                        <Label Text="{Binding QuersummeText}" TextColor="{StaticResource C_TextDark}" FontSize="18" FontAttributes="Bold"/>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="2"
                                     Spacing="8"
                                     BindableLayout.ItemsSource="{Binding PurchasedHints}"
                                     IsVisible="{Binding HasHints}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{StaticResource C_Warning}" Offset="0"/>
                                        <GradientStop Color="{StaticResource C_GoldDark}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Label Text="{Binding .}"
                                       TextColor="{StaticResource C_TextDark}"
                                       FontAttributes="Bold"
                                       FontSize="14"/>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Properties List -->
                <CollectionView Grid.Row="2" ItemsSource="{Binding VisibleProperties}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:NumberPropertyVM">
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{StaticResource C_BgLight}"
                                    Padding="14"
                                    Margin="0,4">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                                    <HorizontalStackLayout Grid.Row="0" Spacing="10" VerticalOptions="Center">
                                        <Label Text="✓" TextColor="{StaticResource C_Success}" 
                                               FontSize="16" FontAttributes="Bold"/>
                                        <Label Text="{Binding Key}" 
                                               TextColor="{StaticResource C_TextPrimary}"
                                               FontAttributes="Bold"
                                               FontSize="14"/>
                                    </HorizontalStackLayout>

                                    <Label Grid.Row="1"
                                           Text="{Binding KidDescription}"
                                           TextColor="{StaticResource C_TextMuted}"
                                           FontSize="12"/>

                                    <Label Grid.Row="2"
                                           Text="{Binding Examples, StringFormat='Beispiele: {0}'}"
                                           TextColor="{StaticResource C_TextMuted}"
                                           FontSize="12"
                                           IsVisible="{Binding ShowExamples}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <!-- INPUT -->
        <Border Grid.Row="3" Style="{StaticResource SolidCard}" Padding="16">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">

                <Border StrokeThickness="2" 
                        Stroke="{StaticResource C_Primary}"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{StaticResource C_BgLight}"
                        Padding="4">
                    <Entry Text="{Binding GuessText}"
                           Placeholder="Zahl eingeben..."
                           Keyboard="Numeric"
                           BackgroundColor="Transparent"
                           TextColor="{StaticResource C_TextPrimary}"
                           PlaceholderColor="{StaticResource C_TextMuted}"
                           FontSize="18"
                           FontAttributes="Bold"/>
                </Border>

                <Button Grid.Column="1" Text="✓"
                        Style="{StaticResource BtnSuccess}"
                        WidthRequest="56" HeightRequest="52"
                        FontSize="22"
                        Command="{Binding GuessCommand}"/>

                <Button Grid.Column="2" Text="💡"
                        BackgroundColor="{StaticResource C_Warning}"
                        TextColor="{StaticResource C_TextDark}"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        WidthRequest="56" HeightRequest="52"
                        FontSize="22"
                        Command="{Binding HintCommand}"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
