<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LogikSpiel.ViewModel"
             xmlns:resx="clr-namespace:LogikSpiel.Resources.Strings"
             x:Class="LogikSpiel.View.MathHangmanPage"
             x:DataType="vm:MathHangmanPageViewModel"
             x:Name="ThisPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundImageSource="gamebg.png">

    <Grid x:Name="RootLayout"
          RowDefinitions="Auto,Auto,*,Auto"
          Padding="{OnIdiom Phone=8, Desktop=12}"
          RowSpacing="{OnIdiom Phone=8, Desktop=12}">

        <!-- HEADER -->
        <Border Grid.Row="0"
                Style="{StaticResource GlassCard}"
                Padding="{OnIdiom Phone=8, Desktop=12}"
                Margin="0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button Grid.Column="0"
                        Text="{resx:Translate Key=Common_Back}"
                        Style="{StaticResource BtnIcon}"
                        WidthRequest="{OnIdiom Phone=76, Desktop=88}"
                        HeightRequest="{OnIdiom Phone=40, Desktop=48}"
                        Padding="10,0"
                        Command="{Binding BackCommand}" />

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="0"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Label Text="{resx:Translate Key=MathHangman_Title}"
                           Style="{StaticResource H3}"
                           HorizontalOptions="Center" />

                    <Label Text="{Binding LevelNumber, StringFormat={x:Static resx:AppRessources.Common_LevelFormat}}"
                           TextColor="{StaticResource C_TextMuted}"
                           FontSize="14"
                           HorizontalOptions="Center" 
                           FontAttributes="Bold"/>
                </VerticalStackLayout>

                <Border Grid.Column="2"
                        Style="{StaticResource CoinBadge}"
                        Padding="{OnIdiom Phone=8, Desktop=10}">
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="💰" FontSize="14" />
                        <Label Text="{Binding Coins}"
                               TextColor="{StaticResource C_Gold}"
                               FontAttributes="Bold" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>

        <!-- HANGMAN -->
        <Border Grid.Row="1"
                Style="{StaticResource GlowCard}"
                HeightRequest="{OnIdiom Phone=200, Desktop=260}"
                Padding="{OnIdiom Phone=8, Desktop=12}">
            <Grid RowDefinitions="Auto,*" RowSpacing="{OnIdiom Phone=6, Desktop=10}">
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="❤️" FontSize="16" />
                        <Label Text="{Binding Lives}"
                               Style="{StaticResource H3}"
                               TextColor="{StaticResource C_Accent}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <Border Grid.Row="1"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{StaticResource C_BgDark}"
                        Padding="0">
                    <GraphicsView x:Name="HangmanView"
                                  HorizontalOptions="Fill"
                                  VerticalOptions="Fill" />
                </Border>
            </Grid>
        </Border>

        <!-- PROPERTIES -->
        <Border Grid.Row="2"
                Style="{StaticResource GlassCard}"
                Padding="{OnIdiom Phone=10, Desktop=12}"
                Margin="0">
   
            <Grid RowDefinitions="Auto,Auto,Auto,*"
                  RowSpacing="{OnIdiom Phone=6, Desktop=10}">

                <Label Grid.Row="0"
                       Text="{resx:Translate Key=MathHangman_PropertiesTitle}"
                       Style="{StaticResource H3}" />

                <!-- Bereich + Quersumme -->
                <VerticalStackLayout Grid.Row="1" Spacing="6">
                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{StaticResource C_Accent}"
                            Padding="{OnIdiom Phone=8, Desktop=10}">
                        <Label Text="{Binding DifficultyText}"
                               TextColor="{StaticResource C_TextDark}"
                               FontSize="{OnIdiom Phone=16, Desktop=18}"
                               FontAttributes="Bold" />
                    </Border>

                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{StaticResource C_Accent}"
                            Padding="{OnIdiom Phone=8, Desktop=10}">
                        <Label Text="{Binding QuersummeText}"
                               TextColor="{StaticResource C_TextDark}"
                               FontSize="{OnIdiom Phone=16, Desktop=18}"
                               FontAttributes="Bold" />
                    </Border>
                </VerticalStackLayout>

                <!-- Eigenschaften (kompakt, fix sichtbar) -->
                <VerticalStackLayout Grid.Row="2"
                                     Spacing="3"
                                     BindableLayout.ItemsSource="{Binding VisibleProperties}">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:NumberPropertyVM">
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource C_BgLight}"
                                    Padding="{OnIdiom Phone=8, Desktop=10}"
                                    Margin="0,1">
                                <Grid ColumnDefinitions="*,Auto"
                                      RowDefinitions="Auto,Auto,Auto"
                                      ColumnSpacing="8"
                                      RowSpacing="1">

                                    <HorizontalStackLayout Grid.Row="0"
                                                           Spacing="6"
                                                           VerticalOptions="Center">
                                        <Label Text="✓"
                                               TextColor="{StaticResource C_Success}"
                                               FontSize="18"
                                               FontAttributes="Bold" />
                                        <Label Text="{Binding Key}"
                                               TextColor="{StaticResource C_TextPrimary}"
                                               FontAttributes="Bold"
                                               FontSize="{OnIdiom Phone=18, Desktop=19}" />
                                    </HorizontalStackLayout>

                                    <Label Grid.Row="1"
                                           Text="{Binding KidDescription}"
                                           TextColor="{StaticResource C_TextMuted}"
                                           FontSize="{OnIdiom Phone=16, Desktop=17}" />

                                    <Label Grid.Row="2"
                                           Text="{Binding Examples, StringFormat={x:Static resx:AppRessources.MathHangman_ExamplesFormat}}"
                                           TextColor="{StaticResource C_TextMuted}"
                                           FontSize="{OnIdiom Phone=16, Desktop=17}"
                                           IsVisible="{Binding ShowExamples}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Hinweise (scrollen) -->
                <Grid Grid.Row="3"
                      IsVisible="{Binding HasHints}"
                      RowDefinitions="Auto,*"
                      RowSpacing="6">

                    <Label Grid.Row="0"
                           Text="{resx:Translate Key=MathHangman_HintsTitle}"
                           Style="{StaticResource H3}" />

                    <CollectionView Grid.Row="1"
                                    ItemsSource="{Binding PurchasedHints}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="{OnIdiom Phone=10, Desktop=12}"
                                        Margin="0,0,0,6">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="{StaticResource C_Warning}" Offset="0" />
                                            <GradientStop Color="{StaticResource C_GoldDark}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>

                                    <Label Text="{Binding}"
                                           TextColor="{StaticResource C_TextDark}"
                                           FontAttributes="Bold"
                                           FontSize="{OnIdiom Phone=16, Desktop=17}"
                                           LineBreakMode="WordWrap" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </Grid>

            </Grid>
        </Border>

        <!-- INPUT -->
        <Border Grid.Row="3"
                Style="{StaticResource SolidCard}"
                Padding="{OnIdiom Phone=10, Desktop=16}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">

                <Border StrokeThickness="2"
                        Stroke="{StaticResource C_Primary}"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{StaticResource C_BgLight}"
                        Padding="4">
                    <Entry Text="{Binding GuessText}"
                           Placeholder="{resx:Translate Key=MathHangman_GuessPlaceholder}"
                           Keyboard="Numeric"
                           BackgroundColor="Transparent"
                           TextColor="{StaticResource C_TextPrimary}"
                           PlaceholderColor="{StaticResource C_TextMuted}"
                           FontSize="{OnIdiom Phone=16, Desktop=18}"
                           FontAttributes="Bold"/>
                </Border>

                <Button Grid.Column="1"
                        Text="✓"
                        Style="{StaticResource BtnSuccess}"
                        WidthRequest="{OnIdiom Phone=52, Desktop=56}"
                        HeightRequest="{OnIdiom Phone=48, Desktop=52}"
                        FontSize="{OnIdiom Phone=20, Desktop=22}"
                        Command="{Binding GuessCommand}" />

                <Button Grid.Column="2"
                        Text="💡"
                        BackgroundColor="{StaticResource C_Warning}"
                        TextColor="{StaticResource C_TextDark}"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        WidthRequest="{OnIdiom Phone=52, Desktop=56}"
                        HeightRequest="{OnIdiom Phone=48, Desktop=52}"
                        FontSize="{OnIdiom Phone=20, Desktop=22}"
                        Command="{Binding HintCommand}" />
            </Grid>
        </Border>

    </Grid>
</ContentPage>
