<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LogikSpiel.ViewModel"
             xmlns:model="clr-namespace:LogikSpiel.Model"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="LogikSpiel.View.PuzzlePage"
             x:DataType="vm:PuzzlePageViewModel"
             x:Name="ThisPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource BgGradient}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="16">
        <Image Source="spielbg.jpg"
           Grid.RowSpan="2"
           Aspect="AspectFill"
           Opacity="0.4"
           InputTransparent="True" />
        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Text="←" Style="{StaticResource BtnIcon}"
                        Command="{Binding BackCommand}" IsEnabled="{Binding IsNotBusy}"/>

                <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource H3}"
                       HorizontalOptions="Center" VerticalOptions="Center"/>

                <Border Grid.Column="2" Style="{StaticResource Chip}">
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="💰" FontSize="14"/>
                        <Label Text="{Binding Coins}" TextColor="{StaticResource C_Gold}" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>

        <!-- CODE INPUT -->
        <Border Grid.Row="1" Style="{StaticResource GlowCard}">
            <VerticalStackLayout Spacing="16">

                <Label Text="🔐 GIB DEN CODE EIN" 
                       Style="{StaticResource Caption}"
                       CharacterSpacing="3"
                       HorizontalOptions="Center"/>

                <Image Source="{Binding LockImageSource}"
                       HeightRequest="70"
                       HorizontalOptions="Center"/>

                <!-- Digit Input Boxes - MIT KORREKTEM x:DataType -->
                <HorizontalStackLayout Spacing="12" HorizontalOptions="Center"
                                       BindableLayout.ItemsSource="{Binding InputDigits}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:DigitInputViewModel">
                            <Border StrokeThickness="2"
                                    Stroke="{StaticResource C_Primary}"
                                    StrokeShape="RoundRectangle 14"
                                    HeightRequest="65" WidthRequest="55"
                                    BackgroundColor="{StaticResource C_BgLight}">
                                <Entry Text="{Binding Digit}"
                                       Loaded="DigitEntry_Loaded"
                                       Unloaded="DigitEntry_Unloaded"
                                       TextChanged="DigitEntry_TextChanged"
                                       IsReadOnly="{Binding IsLocked}"
                                       MaxLength="1"
                                       Keyboard="Numeric"
                                       FontSize="28" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource C_TextPrimary}"
                                       HorizontalTextAlignment="Center" 
                                       VerticalTextAlignment="Center"
                                       BackgroundColor="Transparent"/>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Grid.Column="0" Text="💡 Tipp (10)"
                            Style="{StaticResource BtnPrimary}"
                            Command="{Binding HintCommand}"
                            IsEnabled="{Binding IsNotBusy}"/>

                    <Button Grid.Column="1" Text="🔓 Öffnen"
                            Style="{StaticResource BtnAccent}"
                            Command="{Binding CheckCommand}"
                            IsEnabled="{Binding IsNotBusy}"/>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- HINTS LIST -->
        <Grid Grid.Row="2">
            <CollectionView ItemsSource="{Binding Hints}">
                <CollectionView.Header>
                    <HorizontalStackLayout Spacing="10" Margin="0,0,0,12">
                        <BoxView WidthRequest="4" HeightRequest="24" 
                                 Color="{StaticResource C_Accent}" CornerRadius="2"/>
                        <Label Text="HINWEISE" Style="{StaticResource H3}"/>
                    </HorizontalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <!-- KORREKTES x:DataType für LockHint -->
                    <DataTemplate x:DataType="model:LockHint">
                        <Border Style="{StaticResource GlassCard}" 
                                Margin="0,0,0,10"
                                Padding="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                                <!-- Slot Display -->
                                <HorizontalStackLayout Spacing="4"
                                                       BindableLayout.ItemsSource="{Binding Slots}"
                                                       VerticalOptions="Center">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border StrokeThickness="0"
                                                    BackgroundColor="{StaticResource C_BgLight}"
                                                    StrokeShape="RoundRectangle 6"
                                                    WidthRequest="26" HeightRequest="32"
                                                    Padding="0">
                                                <Label Text="{Binding .}"
                                                       FontAttributes="Bold"
                                                       FontSize="15"
                                                       TextColor="{StaticResource C_TextPrimary}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>

                                <Label Grid.Column="1" 
                                       Text="{Binding Description}" 
                                       Style="{StaticResource Body}"
                                       VerticalOptions="Center"
                                       LineBreakMode="WordWrap"/>

                                <Label Grid.Column="2" 
                                       Text="{Binding Icon}" 
                                       FontSize="24" 
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Loading -->
            <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#DD000000">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                    <ActivityIndicator IsRunning="True" Color="{StaticResource C_Primary}"/>
                    <Label Text="Erzeuge Rätsel..." Style="{StaticResource Body}"/>
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- CELEBRATION -->
        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsCelebrating}"
              BackgroundColor="#01000000"
              InputTransparent="False">

            <skia:SKLottieView x:Name="FireworksView"
                               Source="fireworks_skottie.json"
                               RepeatCount="-1"
                               IsAnimationEnabled="True"
                               Opacity="0.9"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill"/>

            <Border Style="{StaticResource GlowCard}"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Padding="40">
                <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
                    <Label Text="🎉 GELÖST!" 
                           Style="{StaticResource H1}"
                           TextColor="{StaticResource C_Success}"
                           HorizontalOptions="Center"/>

                    <Image x:Name="OpenedLockImage"
                           Source="openedlock.png"
                           HeightRequest="120"
                           HorizontalOptions="Center"/>

                    <Label Text="{Binding RewardText}"
                           Style="{StaticResource H3}"
                           TextColor="{StaticResource C_Gold}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
