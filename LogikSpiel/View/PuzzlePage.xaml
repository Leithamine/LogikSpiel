<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LogikSpiel.ViewModel"
             xmlns:model="clr-namespace:LogikSpiel.Model"
             x:Class="LogikSpiel.View.PuzzlePage"
             x:DataType="vm:PuzzlePageViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ✅ HEADER BAR -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource C_GlassStrong}"
              Padding="15,10"
              ColumnDefinitions="Auto,*,Auto">

            <!-- Zurück Button Links -->
            <Button Grid.Column="0"
                    Text="&#x2190;"
                    FontSize="24"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    Command="{Binding BackCommand}"
                    WidthRequest="50"
                    HeightRequest="50"
                    CornerRadius="25"/>

            <!-- Titel Mitte -->
            <VerticalStackLayout Grid.Column="1"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Label Text="{Binding Title}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Coins Rechts -->
            <HorizontalStackLayout Grid.Column="2"
                                   VerticalOptions="Center"
                                   Spacing="5">
                <Label Text="&#x1F4B0;"
                       FontSize="20"/>
                <Label Text="{Binding Coins}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- ✅ LEVEL NUMMER ANZEIGE -->
        <Grid Grid.Row="1"
              BackgroundColor="{StaticResource C_PrimaryDark}"
              Padding="10,5">
            <Label Text="{Binding LevelDisplayText}"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"/>
        </Grid>

        <!-- ✅ HAUPTINHALT -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Loading Indicator -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource C_Primary}"
                                   HeightRequest="50"
                                   WidthRequest="50"/>

                <!-- Professor (sichtbar bei Bedarf) -->
                <Grid IsVisible="{Binding ShowProfessor}"
                      HorizontalOptions="Center"
                      Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Source="{Binding ProfessorImageSource}"
                           WidthRequest="80"
                           HeightRequest="80"
                           Aspect="AspectFit"/>

                    <Frame Grid.Column="1"
                           BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#1E3A5F}"
                           BorderColor="{StaticResource C_Primary}"
                           CornerRadius="15"
                           Padding="15"
                           Margin="10,0,0,0">
                        <Label Text="{Binding ProfessorMessage}"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    </Frame>
                </Grid>

                <!-- Schloss Bild -->
                <Image Source="{Binding LockImageSource}"
                       WidthRequest="120"
                       HeightRequest="120"
                       Aspect="AspectFit"
                       HorizontalOptions="Center">
                    <Image.Triggers>
                        <DataTrigger TargetType="Image"
                                     Binding="{Binding IsCelebrating}"
                                     Value="True">
                            <Setter Property="Source" Value="openedlock.png"/>
                        </DataTrigger>
                    </Image.Triggers>
                </Image>

                <!-- Feuerwerk (nur bei Erfolg) -->
                <skia:SKLottieView Source="fireworks.json"
                                   HeightRequest="140"
                                   WidthRequest="260"
                                   HorizontalOptions="Center"
                                   IsAnimationEnabled="{Binding IsCelebrating}"
                                   IsVisible="{Binding IsCelebrating}"
                                   RepeatCount="2" />

                <!-- Belohnungstext -->
                <Label Text="{Binding RewardText}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource C_Success}"
                       HorizontalOptions="Center"
                       IsVisible="{Binding IsCelebrating}"/>

                <!-- Eingabe Bereich -->
                <VerticalStackLayout IsVisible="{Binding IsNotBusy}" Spacing="15">

                    <!-- Code Eingabe Label -->
                    <Label Text="{StaticResource Puzzle_EnterCode}"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                    <!-- Ziffern Eingabe -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                        <BindableLayout.ItemsSource>
                            <Binding Path="InputDigits"/>
                        </BindableLayout.ItemsSource>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:DigitInputViewModel">
                                <Frame BorderColor="{StaticResource C_Primary}"
                                       BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2C}"
                                       CornerRadius="10"
                                       Padding="5"
                                       WidthRequest="60"
                                       HeightRequest="70">
                                    <Entry Text="{Binding Digit, Mode=TwoWay}"
                                           Keyboard="Numeric"
                                           MaxLength="1"
                                           FontSize="28"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                           IsReadOnly="{Binding IsLocked}"
                                           BackgroundColor="Transparent"
                                           Loaded="DigitEntry_Loaded"
                                           Unloaded="DigitEntry_Unloaded"
                                           TextChanged="DigitEntry_TextChanged"/>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>

                    <!-- Hinweise Überschrift -->
                    <Label Text="{StaticResource Puzzle_HintsTitle}"
                           FontSize="18"
                           FontAttributes="Bold"
                           Margin="0,20,0,0"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                    <!-- Hinweise Liste -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Hints}"
                                         Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="model:LockHint">
                                <Frame BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#3C3C3C}"
                                       CornerRadius="10"
                                       Padding="15">
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="{Binding Code}"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               FontFamily="Consolas"
                                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                        <Label Text="{Binding Description}"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Debug: Lösung anzeigen -->
                    <Label IsVisible="{Binding ShowSolutionForDebug}"
                           Text="{Binding SecretSolution, StringFormat='Lösung: {0}'}"
                           FontSize="12"
                           TextColor="Gray"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ✅ BUTTON LEISTE UNTEN -->
        <Grid Grid.Row="3"
              BackgroundColor="{StaticResource C_GlassStrong}"
              Padding="15"
              ColumnDefinitions="*,Auto,*"
              IsVisible="{Binding IsNotBusy}">

            <!-- Tipp Button -->
            <Button Grid.Column="0"
                    Text="{StaticResource Puzzle_HintButton}"
                    Command="{Binding HintCommand}"
                    BackgroundColor="{StaticResource C_PrimaryDark}"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    HorizontalOptions="Fill"/>

            <!-- Öffnen Button -->
            <Button Grid.Column="1"
                    Text="{StaticResource Puzzle_OpenButton}"
                    Command="{Binding CheckCommand}"
                    BackgroundColor="{StaticResource C_Primary}"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    WidthRequest="120"
                    Margin="10,0"/>

            <!-- Platzhalter für Balance -->
            <BoxView Grid.Column="2"
                     BackgroundColor="Transparent"
                     WidthRequest="80"/>
        </Grid>
    </Grid>
</ContentPage>
