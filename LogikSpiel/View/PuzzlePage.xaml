<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LogikSpiel.ViewModel"
             xmlns:model="clr-namespace:LogikSpiel.Model"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="LogikSpiel.View.PuzzlePage"
             x:DataType="vm:PuzzlePageViewModel"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#BB86FC" Offset="0"/>
            <GradientStop Color="#03DAC5" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <!-- ✅ 3 Rows: Header / Input / Hints -->
    <Grid RowDefinitions="Auto, Auto, *" Padding="20" RowSpacing="15">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" HeightRequest="50">
            <Button Grid.Column="0" Text="&#x2190;" Command="{Binding BackCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    BackgroundColor="#20FFFFFF" TextColor="White" FontAttributes="Bold"
                    WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0"/>

            <Label Grid.Column="1" Text="{Binding Title}"
                   TextColor="White" FontAttributes="Bold" FontSize="18"
                   VerticalOptions="Center" HorizontalOptions="Center"/>

            <Label Grid.Column="2" Text="{Binding Coins, StringFormat='💰 {0}'}"
                   TextColor="#FFD700" FontAttributes="Bold" FontSize="16"
                   VerticalOptions="Center"/>
        </Grid>

        <!-- Input Panel -->
        <Border Grid.Row="1" StrokeShape="RoundRectangle 20" BackgroundColor="Transparent" Padding="20" StrokeThickness="0">
            <VerticalStackLayout Spacing="10">
                <Label Text="GIB DEN CODE EIN" FontSize="12" TextColor="#555" HorizontalOptions="Center" CharacterSpacing="2"/>

                <!-- ✅ Schloss: geschlossen beim Laden, öffnet sich bei Erfolg -->
                <Image Source="{Binding LockImageSource}"
                       HeightRequest="60"
                       HorizontalOptions="Center"
                       Margin="0,-2,0,0"/>

                <!--<Label Text="{Binding SecretSolution, StringFormat='Lösung (Debug): {0}'}"
                       IsVisible="{Binding ShowSolutionForDebug}"
                       FontSize="12" TextColor="#333" FontAttributes="Bold"
                       HorizontalOptions="Center"/>-->

                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding InputDigits}"
                                       Spacing="10" HorizontalOptions="Center">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:DigitInputViewModel">
                            <Border Stroke="#6200EE" StrokeThickness="2" StrokeShape="RoundRectangle 12"
                                    HeightRequest="60" WidthRequest="50" BackgroundColor="White">
                                <Entry Text="{Binding Digit}"
                                       Loaded="DigitEntry_Loaded"
                                       Unloaded="DigitEntry_Unloaded"
                                       TextChanged="DigitEntry_TextChanged"
                                       IsReadOnly="{Binding IsLocked}"
                                       IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IsNotBusy}"
                                       MaxLength="1"
                                       Keyboard="Numeric"
                                       ReturnType="Next"
                                       FontSize="28" FontAttributes="Bold" TextColor="#333"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                       BackgroundColor="Transparent"/>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>

                <!-- ✅ Buttons (bleiben wo sie sind – im Input-Bereich) -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,8,0,0">
                    <Button Grid.Column="0" Text="💡 Tipp (10)"
                            Command="{Binding HintCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="#03DAC5" TextColor="#000" FontAttributes="Bold"
                            CornerRadius="15" HeightRequest="55"/>

                    <Button Grid.Column="1" Text="🔓 Öffnen"
                            Command="{Binding CheckCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="#BB86FC" TextColor="White" FontAttributes="Bold"
                            CornerRadius="15" HeightRequest="55"/>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Hints -->
        <Grid Grid.Row="2">
            <CollectionView ItemsSource="{Binding Hints}" Margin="0,5">
                <CollectionView.Header>
                    <Label Text="HINWEISE" FontSize="14" FontAttributes="Bold" TextColor="White" Margin="0,0,0,10"/>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:LockHint">
                        <Border StrokeShape="RoundRectangle 15" BackgroundColor="Transparent" Padding="15" Margin="0,0,0,10" StrokeThickness="0">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                                    <HorizontalStackLayout Spacing="4"
                                                           BindableLayout.ItemsSource="{Binding Slots}"
                                                           HorizontalOptions="Center">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border StrokeThickness="0"
                                                        BackgroundColor="White"
                                                        StrokeShape="RoundRectangle 6"
                                                        WidthRequest="22" HeightRequest="28"
                                                        Padding="0">
                                                    <Label Text="{Binding ., Converter={StaticResource StringOrBulletConverter}}"
                                                           FontAttributes="Bold"
                                                           FontSize="14"
                                                           TextColor="#111"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"
                                                           HorizontalTextAlignment="Center"
                                                           VerticalTextAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Label Grid.Column="1" Text="{Binding Description}" FontSize="15" FontAttributes="Bold" TextColor="White"
                                       VerticalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
                                <Label Grid.Column="2" Text="{Binding Icon}" FontSize="20" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Busy Overlay -->
            <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#66000000">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                    <ActivityIndicator IsRunning="True" />
                    <Label Text="Erzeuge Rätsel..." TextColor="White" FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- ✅ SUCCESS OVERLAY (wie UnlockSuccessPage, aber in PuzzlePage) -->
        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsCelebrating}"
              BackgroundColor="#01000000"
              InputTransparent="False">

            <skia:SKLottieView x:Name="FireworksView"
                               Source="fireworks_skottie.json"
                               RepeatCount="-1"
                               IsAnimationEnabled="True"
                               Opacity="0.9"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill"/>

            <VerticalStackLayout Spacing="16"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">

                <Label Text="GELÖST! 🎉"
                       TextColor="White"
                       FontSize="26"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"/>

                <Image x:Name="OpenedLockImage"
                       Source="openedlock.png"
                       HeightRequest="160"
                       HorizontalOptions="Center"/>

                <Label Text="{Binding RewardText}"
                       TextColor="White"
                       FontSize="16"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
