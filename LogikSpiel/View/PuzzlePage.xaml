<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="LogikSpiel.View.PuzzlePage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#BB86FC" Offset="0"/>
            <GradientStop Color="#03DAC5" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid Padding="20" RowDefinitions="Auto,*,Auto" RowSpacing="20">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="10" HeightRequest="60" BackgroundColor="#20000000">
            <Button Grid.Column="0" Text="Zurück" Command="{Binding BackCommand}" BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold"/>
            <Label Grid.Column="1" Text="{Binding Title}" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center"/>
            <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                <Label Text="{Binding Coins, StringFormat='💰 {0}'}" TextColor="#FFD700" FontAttributes="Bold" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>

        <Border Grid.Row="1" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 18" Padding="14" VerticalOptions="Fill">
            <Label Text="Hier kommt das Rätsel hin..." TextColor="#2B2B2B" VerticalOptions="Center" HorizontalOptions="Center"/>
        </Border>

        <HorizontalStackLayout Grid.Row="2" Spacing="15" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,20">
            <Button Text="Hinweise 💡" Command="{Binding HintCommand}" BackgroundColor="#018786" TextColor="White" CornerRadius="14" HeightRequest="50" WidthRequest="140"/>
            <Button Text="Lösen ✅" Command="{Binding SolveCommand}" BackgroundColor="#BB86FC" TextColor="White" CornerRadius="14" HeightRequest="50" WidthRequest="140"/>
        </HorizontalStackLayout>

    </Grid>
</ContentPage>