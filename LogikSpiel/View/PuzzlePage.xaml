<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LogikSpiel.ViewModel"
             xmlns:model="clr-namespace:LogikSpiel.Model"
             xmlns:resx="clr-namespace:LogikSpiel.Resources.Strings"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="LogikSpiel.View.PuzzlePage"
             x:DataType="vm:PuzzlePageViewModel"
             BackgroundImageSource="gamebg.png"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, *"
          Padding="{OnIdiom Phone=8, Desktop=12}"
          RowSpacing="{OnIdiom Phone=8, Desktop=12}">

        <!-- HEADER BAR -->
        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="{OnIdiom Phone=8, Desktop=12}" Margin="0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button Grid.Column="0"
                        Text="&#x2190;"
                        Style="{StaticResource BtnIcon}"
                        WidthRequest="{OnIdiom Phone=76, Desktop=88}"
                        HeightRequest="{OnIdiom Phone=40, Desktop=48}"
                        Padding="10,0"
                        Command="{Binding BackCommand}"/>

                <VerticalStackLayout Grid.Column="1" Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="{Binding Title}" Style="{StaticResource H3}" HorizontalOptions="Center"/>
                    <Label Text="{Binding LevelDisplayText}" TextColor="{StaticResource C_TextMuted}" FontSize="14" HorizontalOptions="Center" FontAttributes="Bold"/>
                </VerticalStackLayout>

                <Border Grid.Column="2" Style="{StaticResource CoinBadge}" Padding="{OnIdiom Phone=8, Desktop=10}">
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="&#x1F4B0;" FontSize="14"/>
                        <Label Text="{Binding Coins}" TextColor="{StaticResource C_Gold}" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>

        <!-- SCHLOSS + EINGABE BORDER -->
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="{OnIdiom Phone=12, Desktop=16}" Margin="0">

            <VerticalStackLayout Spacing="14">

                <!-- 👨‍🏫 Professor + Bubble -->
                <Grid IsVisible="{Binding ShowProfessor}"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="0"
                      HorizontalOptions="Center"
                      Margin="0, 0, 0, -10">
                    <Image x:Name="ProfessorImage"
                           Grid.Column="0"
                           Source="{Binding ProfessorImageSource}"
                           WidthRequest="110"  HeightRequest="110"
                           Aspect="AspectFit"
                           VerticalOptions="Start"/>
                    <Grid Grid.Column="1" VerticalOptions="Start" Margin="0, 20, 0, 0">

                        <!-- Tail shape that visibly connects bubble to the professor -->
                        <Grid x:Name="SpeechTailGroup"
                              Margin="4,0,0,0"
                              WidthRequest="28"
                              HeightRequest="44"
                              InputTransparent="True"
                              HorizontalOptions="Start"
                              VerticalOptions="Center"
                              ZIndex="2"
                              Scale="0"
                              Opacity="0">
                            <Path x:Name="SpeechTailMain"
                                  Data="M 24,2 L 24,28 L 2,18 Z"
                                  Fill="{AppThemeBinding Light={StaticResource C_CardInner}, Dark={StaticResource C_Card}}"
                                  Stroke="{StaticResource C_Primary}"
                                  StrokeThickness="1.6"
                                  HorizontalOptions="Start"
                                  VerticalOptions="Center"/>
                            <Border x:Name="SpeechTailTip"
                                    WidthRequest="9"
                                    HeightRequest="9"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource C_CardInner}, Dark={StaticResource C_Card}}"
                                    Stroke="{StaticResource C_Primary}"
                                    StrokeThickness="1.2"
                                    StrokeShape="RoundRectangle 5"
                                    HorizontalOptions="Start"
                                    VerticalOptions="End"
                                    Margin="-1,0,0,2"/>
                        </Grid>

                        <Border x:Name="SpeechBubble"
                                Margin="24, 0, 0, 0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource C_CardInner}, Dark={StaticResource C_Card}}"
                                Stroke="{StaticResource C_Primary}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 18"
                                Scale="0"
                                Opacity="0"
                                Padding="14,10"
                                ZIndex="1">
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource C_Primary}"
                                        Opacity="0.35"
                                        Radius="12"/>
                            </Border.Shadow>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                <Label x:Name="ProfessorLabel"
                                       Text="{Binding ProfessorMessage}"
                                       FontSize="15"
                                       LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light={StaticResource C_TextDark}, Dark={StaticResource C_TextPrimary}}"/>
                                <Button Grid.Column="1"
                                        Text="✕"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource C_Error}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        Padding="0"
                                        Margin="2,0,0,0"
                                        IsVisible="{Binding CanCloseProfessor}"
                                        Command="{Binding CloseProfessorCommand}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 🔒 Schlossbereich -->
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        Padding="10">

                    <Grid HeightRequest="140">

                        <!-- Schloss -->
                        <Image x:Name="LockImage"
                               Source="{Binding LockImageSource}"
                               WidthRequest="110"
                               HeightRequest="110"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>

                        <!-- Feuerwerk -->
                        <skia:SKLottieView Source="fireworks_skottie.json"
                                           RepeatCount="-1"
                                           IsVisible="{Binding IsCelebrating}"
                                           HorizontalOptions="Fill"
                                           VerticalOptions="Fill"
                                           InputTransparent="True"/>

                        <!-- Reward -->
                        <Label Text="{Binding RewardText}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource C_Success}"
                               HorizontalOptions="Center"
                               VerticalOptions="End"
                               IsVisible="{Binding IsCelebrating}"/>
                    </Grid>
                </Border>

                <!-- 🔢 Eingabe DIREKT unter Schloss -->
                <VerticalStackLayout IsVisible="{Binding IsNotBusy}"
                                     Spacing="10">

                    <Label Text="{resx:Translate Key=Puzzle_EnterCode}"
                           Style="{StaticResource H3}"
                           HorizontalOptions="Center"/>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <BindableLayout.ItemsSource>
                            <Binding Path="InputDigits"/>
                        </BindableLayout.ItemsSource>

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:DigitInputViewModel">
                                <Border Style="{StaticResource DigitBox}">
                                    <Entry Text="{Binding Digit, Mode=TwoWay}"
                                           Keyboard="Numeric"
                                           MaxLength="1"
                                           FontSize="28"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           TextColor="{StaticResource C_TextPrimary}"
                                           IsReadOnly="{Binding IsLocked}"
                                           BackgroundColor="Transparent"
                                           Loaded="DigitEntry_Loaded"
                                           Unloaded="DigitEntry_Unloaded"
                                           TextChanged="DigitEntry_TextChanged"/>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>

                    <!-- Buttons -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">

                        <Button Grid.Column="0"
                                Text="Öffnen"
                                Style="{StaticResource BtnSuccess}"
                                HeightRequest="50"
                                Command="{Binding CheckCommand}"/>

                        <Button Grid.Column="1"
                                Text="💡"
                                BackgroundColor="{StaticResource C_Warning}"
                                TextColor="{StaticResource C_TextDark}"
                                CornerRadius="14"
                                HeightRequest="50"
                                FontSize="20"
                                Command="{Binding HintCommand}"/>

                        <Button Grid.Column="2"
                                Text="Show"
                                Style="{StaticResource BtnGhost}"
                                HeightRequest="50"
                                Command="{Binding ShowSolutionCommand}"/>
                    </Grid>

                    <!-- Debug -->
                    <Label IsVisible="{Binding ShowSolutionForDebug}"
                           Text="{Binding SecretSolution, StringFormat='Lösung: {0}'}"
                           FontSize="12"
                           TextColor="{StaticResource C_TextMuted}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- ▶ Weiter / Zurück -->
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="10"
                      IsVisible="{Binding IsCelebrating}">

                    <Button Grid.Column="0"
                            Text="Weiter ▶"
                            Style="{StaticResource BtnSuccess}"
                            HeightRequest="50"
                            Command="{Binding ContinueCommand}"/>

                    <Button Grid.Column="1"
                            Text="Zurück"
                            Style="{StaticResource BtnGhost}"
                            HeightRequest="50"
                            Command="{Binding BackToMapCommand}"/>
                </Grid>

            </VerticalStackLayout>
        </Border>

        <!-- HINWEISE BORDER -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="{OnIdiom Phone=12, Desktop=16}" Margin="0">
            <Grid RowDefinitions="Auto, *" RowSpacing="8">

                <!-- Überschrift -->
                <Label Grid.Row="0"
                       Text="{resx:Translate Key=Puzzle_HintsTitle}"
                       Style="{StaticResource H3}"/>

                <!-- Hinweise Liste -->
                <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Always">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Hints}" Spacing="8" Padding="0,0,8,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="model:LockHint">
                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{StaticResource C_BgLight}"
                                        Padding="12">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                            <HorizontalStackLayout Grid.Column="0"
                                                                   BindableLayout.ItemsSource="{Binding Slots}"
                                                                   Spacing="6"
                                                                   VerticalOptions="Center">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border BackgroundColor="{StaticResource C_CardInner}"
                                                                Stroke="{StaticResource C_Primary}"
                                                                StrokeThickness="1"
                                                                StrokeShape="RoundRectangle 8"
                                                                Padding="8,4"
                                                                MinimumWidthRequest="34">
                                                            <Label Text="{Binding .}"
                                                                   FontSize="20"
                                                                   FontAttributes="Bold"
                                                                   HorizontalTextAlignment="Center"
                                                                   TextColor="{StaticResource C_TextPrimary}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </HorizontalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Icon}"
                                                   FontSize="22"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="End"
                                                   MinimumWidthRequest="40"
                                                   HorizontalTextAlignment="End"/>
                                        </Grid>
                                        <Label Text="{Binding Description}"
                                               FontSize="13"
                                               TextColor="{StaticResource C_TextSecondary}"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>

            </Grid>
        </Border>

        <!-- LOADING INDICATOR -->
        <Grid Grid.RowSpan="3" IsVisible="{Binding IsBusy}" BackgroundColor="#DD000000" InputTransparent="False">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource C_Primary}" HeightRequest="60" WidthRequest="60" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

    </Grid>
</ContentPage>
