<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LogikSpiel.ViewModel"
             xmlns:model="clr-namespace:LogikSpiel.Model"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="LogikSpiel.View.PuzzlePage"
             x:DataType="vm:PuzzlePageViewModel"
             BackgroundImageSource="gamebg.png"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Top-Bar: links zurück, mitte Titel+Level, rechts Coins -->
        <Grid Grid.Row="0"
              Padding="14,10"
              BackgroundColor="{StaticResource C_GlassStrong}"
              ColumnDefinitions="Auto,*,Auto">

            <Button Grid.Column="0"
                    Text="←"
                    Command="{Binding BackCommand}"
                    Style="{StaticResource BtnGhost}"
                    WidthRequest="56"
                    HeightRequest="44"
                    FontSize="18" />

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="0"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Label Text="{Binding Title}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource C_TextPrimary}"
                       HorizontalTextAlignment="Center" />
                <Label Text="{Binding LevelDisplayText}"
                       FontSize="13"
                       TextColor="{StaticResource C_TextSecondary}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border Grid.Column="2" Style="{StaticResource CoinBadge}">
                <HorizontalStackLayout Spacing="6">
                    <Label Text="💰" FontSize="16" />
                    <Label Text="{Binding Coins}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource C_Gold}"/>
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="16">

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource C_Primary}"/>

                <!-- Professor immer sichtbar -->
                <Grid IsVisible="{Binding ShowProfessor}" ColumnDefinitions="80,*" ColumnSpacing="10">
                    <Image Grid.Column="0"
                           Source="{Binding ProfessorImageSource}"
                           WidthRequest="76"
                           HeightRequest="76"
                           Aspect="AspectFit"/>
                    <Border Grid.Column="1" Style="{StaticResource GlassCard}">
                        <Label Text="{Binding ProfessorMessage}"
                               FontSize="13"
                               TextColor="{StaticResource C_TextPrimary}"/>
                    </Border>
                </Grid>

                <Image Source="{Binding LockImageSource}"
                       WidthRequest="120"
                       HeightRequest="120"
                       HorizontalOptions="Center" />

                <skia:SKLottieView Source="fireworks.json"
                                   HeightRequest="140"
                                   WidthRequest="260"
                                   HorizontalOptions="Center"
                                   IsAnimationEnabled="{Binding IsCelebrating}"
                                   IsVisible="{Binding IsCelebrating}"
                                   RepeatCount="2" />

                <Label Text="{Binding RewardText}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource C_Gold}"
                       HorizontalOptions="Center"
                       IsVisible="{Binding IsCelebrating}"/>

                <VerticalStackLayout IsVisible="{Binding IsNotBusy}" Spacing="14">
                    <Label Text="{StaticResource Puzzle_EnterCode}"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource C_TextPrimary}"/>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                        <BindableLayout.ItemsSource>
                            <Binding Path="InputDigits"/>
                        </BindableLayout.ItemsSource>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:DigitInputViewModel">
                                <Frame BorderColor="{StaticResource C_Primary}"
                                       BackgroundColor="{StaticResource C_SurfaceStrong}"
                                       CornerRadius="10"
                                       Padding="5"
                                       WidthRequest="60"
                                       HeightRequest="70">
                                    <Entry Text="{Binding Digit, Mode=TwoWay}"
                                           Keyboard="Numeric"
                                           MaxLength="1"
                                           FontSize="28"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           TextColor="{StaticResource C_TextPrimary}"
                                           IsReadOnly="{Binding IsLocked}"
                                           BackgroundColor="Transparent"
                                           Loaded="DigitEntry_Loaded"
                                           Unloaded="DigitEntry_Unloaded"
                                           TextChanged="DigitEntry_TextChanged"/>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="*,Auto,*">
                        <Button Grid.Column="0"
                                Text="{StaticResource Puzzle_HintButton}"
                                Command="{Binding HintCommand}"
                                Style="{StaticResource BtnSecondary}"/>

                        <Button Grid.Column="1"
                                Text="{StaticResource Puzzle_OpenButton}"
                                Command="{Binding CheckCommand}"
                                Style="{StaticResource BtnPrimary}"
                                WidthRequest="130"
                                Margin="10,0"/>

                        <BoxView Grid.Column="2"/>
                    </Grid>

                    <Label Text="{StaticResource Puzzle_HintsTitle}"
                           FontSize="18"
                           FontAttributes="Bold"
                           Margin="0,12,0,0"
                           TextColor="{StaticResource C_TextPrimary}"/>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Hints}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="model:LockHint">
                                <Border Style="{StaticResource GlassCard}">
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="{Binding Code}"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               FontFamily="Consolas"
                                               TextColor="{StaticResource C_TextPrimary}"/>
                                        <Label Text="{Binding Description}"
                                               FontSize="14"
                                               TextColor="{StaticResource C_TextSecondary}"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
