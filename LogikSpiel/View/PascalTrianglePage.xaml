<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LogikSpiel.ViewModel"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="LogikSpiel.View.PascalTrianglePage"
             x:DataType="vm:PascalTrianglePageViewModel"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#BB86FC" Offset="0"/>
            <GradientStop Color="#03DAC5" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="16" RowSpacing="12">

        <!-- HEADER -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" HeightRequest="50">
            <Button Grid.Column="0" 
                    Text="←"
                    Command="{Binding BackCommand}"
                    BackgroundColor="#20FFFFFF"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="20"
                    WidthRequest="44" 
                    HeightRequest="44"
                    CornerRadius="22" 
                    Padding="0"/>

            <Label Grid.Column="1"
                   Text="{Binding Title}"
                   TextColor="White"
                   FontAttributes="Bold"
                   FontSize="17"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   LineBreakMode="TailTruncation"/>

            <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                <Label Text="{Binding Coins, StringFormat='💰 {0}'}"
                       TextColor="#FFD700"
                       FontAttributes="Bold"
                       FontSize="15"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- INFO-BAR -->
        <Border Grid.Row="1" 
                StrokeShape="RoundRectangle 16"
                BackgroundColor="#F5FFFFFF" 
                Padding="12" 
                StrokeThickness="0"
                Shadow="{Shadow Brush=#20000000, Offset='0,2', Radius=4}">

            <Grid RowDefinitions="Auto,Auto" 
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="10" 
                  RowSpacing="6">

                <!-- Aufgaben-Chip (MAX oder MIN) -->
                <Border Grid.Row="0" Grid.Column="0"
                        StrokeThickness="0"
                        Padding="12,6"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{Binding GoalChipColor}"
                        Shadow="{Shadow Brush=#30000000, Offset='0,1', Radius=2}">
                    <Label Text="{Binding GoalChipText}"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="12"/>
                </Border>

                <!-- Aktuelle Summe -->
                <Border Grid.Row="0" Grid.Column="2"
                        StrokeThickness="0"
                        Padding="10,6"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="#EEEEEE">
                    <Label Text="{Binding UserSum, StringFormat='Σ = {0:0.##}'}"
                           TextColor="#333"
                           FontAttributes="Bold"
                           FontSize="14"
                           VerticalOptions="Center"/>
                </Border>

                <!-- Anleitung -->
                <Label Grid.Row="1" Grid.ColumnSpan="3"
                       Text="Tippe Zellen von OBEN nach UNTEN um einen Pfad zu bilden."
                       FontSize="11"
                       TextColor="#666"
                       HorizontalTextAlignment="Center"/>
            </Grid>
        </Border>

        <!-- SPIELFELD (CANVAS) - Nimmt den gesamten verfügbaren Platz -->
        <Border Grid.Row="2" 
                StrokeShape="RoundRectangle 16"
                BackgroundColor="#30FFFFFF" 
                Padding="4" 
                StrokeThickness="0">

            <skia:SKCanvasView x:Name="BoardCanvas"
                               IgnorePixelScaling="False"
                               EnableTouchEvents="True"
                               Touch="BoardCanvas_Touch"
                               PaintSurface="BoardCanvas_PaintSurface"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill"/>
        </Border>

        <!-- BUTTONS -->
        <Grid Grid.Row="3" 
              ColumnDefinitions="*,*" 
              RowDefinitions="Auto,Auto"
              ColumnSpacing="10" 
              RowSpacing="10">

            <Button Grid.Row="0" Grid.Column="0"
                    Text="👁️ Lösung"
                    Command="{Binding ToggleSolutionCommand}"
                    BackgroundColor="#9B59B6"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="14" 
                    HeightRequest="50"
                    FontSize="14"/>

            <Button Grid.Row="0" Grid.Column="1"
                    Text="🧹 Reset"
                    Command="{Binding ResetCommand}"
                    BackgroundColor="#E0E0E0"
                    TextColor="#333"
                    FontAttributes="Bold"
                    CornerRadius="14" 
                    HeightRequest="50"
                    FontSize="14"/>

            <Button Grid.Row="1" Grid.Column="0"
                    Text="💡 Tipp (15)"
                    Command="{Binding HintCommand}"
                    BackgroundColor="#03DAC5"
                    TextColor="#000"
                    FontAttributes="Bold"
                    CornerRadius="14" 
                    HeightRequest="50"
                    FontSize="14"/>

            <Button Grid.Row="1" Grid.Column="1"
                    Text="✅ Prüfen"
                    Command="{Binding CheckCommand}"
                    BackgroundColor="#27AE60"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="14" 
                    HeightRequest="50"
                    FontSize="14"/>
        </Grid>

    </Grid>
</ContentPage>
