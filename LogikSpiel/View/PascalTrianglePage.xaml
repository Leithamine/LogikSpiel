<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LogikSpiel.ViewModel"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="LogikSpiel.View.PascalTrianglePage"
             x:DataType="vm:PascalTrianglePageViewModel"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#BB86FC" Offset="0"/>
            <GradientStop Color="#03DAC5" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="20" RowSpacing="15">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" HeightRequest="50">
            <Button Grid.Column="0" Text="&#x2190;"
                    Command="{Binding BackCommand}"
                    BackgroundColor="#20FFFFFF"
                    TextColor="White"
                    FontAttributes="Bold"
                    WidthRequest="40" HeightRequest="40"
                    CornerRadius="20" Padding="0"/>

            <Label Grid.Column="1"
                   Text="{Binding Title}"
                   TextColor="White"
                   FontAttributes="Bold"
                   FontSize="18"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"/>

            <Label Grid.Column="2"
                   Text="{Binding Coins, StringFormat='💰 {0}'}"
                   TextColor="#FFD700"
                   FontAttributes="Bold"
                   FontSize="16"
                   VerticalOptions="Center"/>
        </Grid>

        <!-- Info-Bar: Aufgabe + Summe -->
        <Border Grid.Row="1" StrokeShape="RoundRectangle 20"
                BackgroundColor="#F0FFFFFF" Padding="14" StrokeThickness="0">

            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="12" RowSpacing="8">

                <Border Grid.Row="0" Grid.Column="0"
                        StrokeThickness="0"
                        Padding="10,6"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{Binding GoalChipColor}">
                    <Label Text="{Binding GoalChipText}"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="13"/>
                </Border>

                <Label Grid.Row="0" Grid.Column="2"
                       Text="{Binding UserSum, StringFormat='Summe: {0}'}"
                       TextColor="#333"
                       FontAttributes="Bold"
                       FontSize="14"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="End"/>

                <Label Grid.Row="1" Grid.ColumnSpan="3"
                       Text="Tippe von oben nach unten (links-unten oder rechts-unten)."
                       FontSize="12"
                       TextColor="#666"/>
            </Grid>
        </Border>

        <!-- Board -->
        <Border Grid.Row="2" StrokeShape="RoundRectangle 20"
                BackgroundColor="Transparent" Padding="12" StrokeThickness="0">
            <skia:SKCanvasView x:Name="BoardCanvas"
                               IgnorePixelScaling="False"
                               EnableTouchEvents="True"
                               Touch="BoardCanvas_Touch"
                               PaintSurface="BoardCanvas_PaintSurface"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill"/>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
              ColumnSpacing="15" RowSpacing="12">

            <Button Grid.Row="0" Grid.Column="0"
                    Text="👁 Lösung"
                    Command="{Binding ToggleSolutionCommand}"
                    BackgroundColor="#BB86FC"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="15" HeightRequest="55"/>

            <Button Grid.Row="0" Grid.Column="1"
                    Text="🧹 Reset"
                    Command="{Binding ResetCommand}"
                    BackgroundColor="#E0E0E0"
                    TextColor="#000"
                    FontAttributes="Bold"
                    CornerRadius="15" HeightRequest="55"/>

            <Button Grid.Row="1" Grid.Column="0"
                    Text="💡 Tipp (15)"
                    Command="{Binding HintCommand}"
                    BackgroundColor="#03DAC5"
                    TextColor="#000"
                    FontAttributes="Bold"
                    CornerRadius="15" HeightRequest="55"/>

            <Button Grid.Row="1" Grid.Column="1"
                    Text="✅ Prüfen"
                    Command="{Binding CheckCommand}"
                    BackgroundColor="#2ECC71"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="15" HeightRequest="55"/>
        </Grid>

    </Grid>
</ContentPage>
