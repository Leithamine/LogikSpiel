<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LogikSpiel.ViewModel"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="LogikSpiel.View.PascalTrianglePage"
             x:DataType="vm:PascalTrianglePageViewModel"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundImageSource="gamebg.png">    
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0">
        <!-- HEADER -->
        <Border Grid.Row="0" 
                BackgroundColor="{StaticResource C_GlassWhite}"
                StrokeThickness="0"
                Padding="12,10">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                <Button Grid.Column="0" Text="←" 
                        Style="{StaticResource IconButton}"
                        Command="{Binding BackCommand}"/>

                <Label Grid.Column="1"
                       Text="{Binding Title}"
                       FontSize="16" FontAttributes="Bold" 
                       TextColor="{StaticResource C_TextPrimary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"/>

                <Border Grid.Column="2" Style="{StaticResource CoinBadge}">
                    <Label Text="{Binding Coins, StringFormat='💰 {0}'}"
                           TextColor="{StaticResource C_Gold}" FontAttributes="Bold"/>
                </Border>
            </Grid>
        </Border>

        <!-- INFO BAR -->
        <Border Grid.Row="1" 
                Style="{StaticResource GlassCard}"
                Margin="12,12,12,0"
                Padding="14">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                <!-- Goal Chip -->
                <Border BackgroundColor="{Binding GoalChipColor}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        Padding="12,8">
                    <Label Text="{Binding GoalChipText}"
                           TextColor="{StaticResource C_TextPrimary}"
                           FontAttributes="Bold"
                           FontSize="13"/>
                </Border>

                <!-- Instructions -->
                <Label Grid.Column="1"
                       Text="Tippe Zellen von oben nach unten"
                       FontSize="12"
                       TextColor="{StaticResource C_TextSecondary}"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center"/>

                <!-- Sum Display -->
                <Border Grid.Column="2"
                        BackgroundColor="{StaticResource C_GlassWhite}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        Padding="12,8">
                    <Label Text="{Binding UserSum, StringFormat='Σ {0:0.##}'}"
                           TextColor="{StaticResource C_TextPrimary}"
                           FontAttributes="Bold"
                           FontSize="14"/>
                </Border>
            </Grid>
        </Border>

        <!-- GAME BOARD -->
        <Border Grid.Row="2" 
                Style="{StaticResource GlassCard}"
                Margin="12,12,12,0">
            <skia:SKCanvasView x:Name="BoardCanvas" 
                       PaintSurface="BoardCanvas_PaintSurface"
                       EnableTouchEvents="True" 
                       Touch="BoardCanvas_Touch" />
        </Border>

        <!-- BUTTONS -->
        <Border Grid.Row="3"
                BackgroundColor="{StaticResource C_GlassWhite}"
                StrokeThickness="0"
                Padding="12,16">
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">

                <Button Grid.Column="0"
                        Text="👁️"
                        Command="{Binding ToggleSolutionCommand}"
                        BackgroundColor="{StaticResource C_Primary}"
                        TextColor="{StaticResource C_TextPrimary}"
                        FontSize="20"
                        CornerRadius="14"
                        HeightRequest="52"/>

                <Button Grid.Column="1"
                        Text="🧹"
                        Command="{Binding ResetCommand}"
                        BackgroundColor="{StaticResource C_GlassHighlight}"
                        TextColor="{StaticResource C_TextPrimary}"
                        FontSize="20"
                        CornerRadius="14"
                        HeightRequest="52"/>

                <Button Grid.Column="2"
                        Text="💡"
                        Command="{Binding HintCommand}"
                        BackgroundColor="{StaticResource C_Warning}"
                        TextColor="{StaticResource C_TextDark}"
                        FontSize="20"
                        CornerRadius="14"
                        HeightRequest="52"/>

                <Button Grid.Column="3"
                        Text="✅"
                        Command="{Binding CheckCommand}"
                        BackgroundColor="{StaticResource C_Success}"
                        TextColor="{StaticResource C_TextPrimary}"
                        FontSize="20"
                        CornerRadius="14"
                        HeightRequest="52"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
