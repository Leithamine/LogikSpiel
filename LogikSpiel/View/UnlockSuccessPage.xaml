<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="LogikSpiel.View.UnlockSuccessPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#BB86FC" Offset="0"/>
            <GradientStop Color="#03DAC5" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid Padding="24">
        <skia:SKLottieView Source="fireworks_skottie.json"
                           RepeatCount="-1"
                           IsAnimationEnabled="True"
                           Opacity="0.9"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill"/>

        <VerticalStackLayout Spacing="16"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">

            <Label Text="GELÖST! 🎉"
                   TextColor="White"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"/>

            <Image Source="openedlock.png"
                   HeightRequest="160"
                   HorizontalOptions="Center"/>

            <Label x:Name="RewardLabel"
                   TextColor="White"
                   FontSize="16"
                   HorizontalTextAlignment="Center"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,10,0,0">
                <Button Grid.Column="0"
                        Text="Weiter ➜"
                        Clicked="Continue_Clicked"
                        BackgroundColor="#03DAC5"
                        TextColor="#000"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        HeightRequest="56"/>

                <Button Grid.Column="1"
                        Text="⬅ Zurück zur Karte"
                        Clicked="BackToMap_Clicked"
                        BackgroundColor="#BB86FC"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        HeightRequest="56"/>
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
